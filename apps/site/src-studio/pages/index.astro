---
// The private posting studio. Not linked from the site, noindex, robots disallow. Rebuilt every morning.
// It answers one question first: what do I post today? Everything else folds away below.
import '../../src/styles/global.css';
import { sharePosts } from '../../src/lib/share';
import { summary } from '../../src/lib/data';
import { longDate } from '../../src/lib/format';
import { plan } from '../lib/plan';
import { templates } from '../lib/templates';
import { news } from '../lib/news';
import PostCard from '../components/PostCard.astro';

const now = new Date();
const from = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
const stories = news.flatMap((n) => (n.match ? [{ date: n.date, post: n.match.post }] : []));
const slots = plan(from, 14, stories);
const todayKey = from.toISOString().slice(0, 10);
const today = slots[0]?.date === todayKey ? slots[0] : null;
const next = slots.filter((s) => s !== today).slice(0, 5);
const todayName = from.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'UTC' });
// Places in the news that are not already today's post: ready if a story breaks and is worth quoting
const otherNews = stories.map((s) => s.post).filter((p) => p !== today?.post);
const words = templates();
const shortDate = (iso: string) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Studio | Galamsey Tracker</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="color-scheme" content="light dark">
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
  </script>
</head>
<body>
  <header class="top">
    <div class="wrap bar">
      <p class="brand">Galamsey Tracker studio</p>
      <button class="icon theme" type="button" data-theme-toggle aria-label="Switch to dark mode">
        <svg class="moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        <svg class="sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </header>

  <main class="wrap">
    <section id="today" class="today">
      <h1>{todayName}</h1>
      {today?.post ? (
        <>
          <p class="when">Post this at 13:00 from <strong>@GalamseyTracker</strong>{today.news && <>, as a quote of the news story it is about</>}.</p>
          <div class="today-grid">
            <PostCard post={today.post} heading={today.title} level="h2" />
            <aside class="steps">
              <h2>How to post it</h2>
              <ol>
                <li>Save the picture.</li>
                <li>In X, start a post{today.news && <> by quoting the story's post from the newsroom's account</>}. Paste the post and add the picture.</li>
                <li>Tap "Add description" on the picture and paste the image description.</li>
                <li>Post it, then reply to your own post with the first reply. The link goes there, never in the post.</li>
              </ol>
              {today.pitch && <p class="extra">Also today: this month's email to one journalist or group. <a href="#email">The email template</a>.</p>}
              {today.news && <p class="extra">Find the newsroom's post of the story on X by searching its headline. If you cannot find it, post without the quote.</p>}
            </aside>
          </div>
        </>
      ) : (
        <p class="when">No post today. Weekends are off. {next[0] && <>Next: {next[0].day}, {next[0].title}.</>}</p>
      )}
    </section>

    <section id="week">
      <h2>Coming up</h2>
      <ol class="slots">
        {next.map((s) => (
          <li><span class="day">{s.day}</span><span>{s.title}</span>{s.pitch && <span class="extra">Plus this month's email</span>}</li>
        ))}
      </ol>
    </section>

    <section id="more">
      <h2>When you need more</h2>

      <details>
        <summary>Galamsey news this week ({news.length} stories{otherNews.length ? `, ${otherNews.length} with a ready picture` : ''})</summary>
        <p class="note">Checked every morning. Stories that name a town or district we cover come with that place's satellite picture, ready to quote the story with. Check the story is about that place and not another place of the same name.</p>
        {otherNews.length > 0 && <div class="cards">{otherNews.map((p) => <PostCard post={p} heading={p.title.replace(/^One place: /, 'In the news: ')} level="h4" textLabel="1. Your quote of the story" />)}</div>}
        <ul class="news">
          {news.map((n) => (
            <li>
              <a href={n.link} rel="noreferrer">{n.title}</a>
              <span class="meta">{n.source}, {shortDate(n.date)}{n.match && <>. Names {n.match.name}</>}</span>
            </li>
          ))}
        </ul>
      </details>

      <details>
        <summary>Every post this week ({sharePosts.length})</summary>
        <p class="note">All kinds of post, made from Monday's data. Use one if a planned post does not suit the day.</p>
        <div class="cards">{sharePosts.map((p) => <PostCard post={p} heading={p.title} level="h4" />)}</div>
      </details>

      <details id="email">
        <summary>Email template, once a month</summary>
        <p class="note">To one journalist, NGO or researcher whose work fits. Change the first line to say why you picked them.</p>
        {words.filter((t) => t.slug === 'email').flatMap((t) => t.fields).map(([label, value]) => (
          <div class="copy"><div class="head"><span class="label">{label}</span><button type="button" class="btn" data-copy>Copy</button></div><p data-text>{value}</p></div>
        ))}
      </details>

      <details>
        <summary>The plan, in short</summary>
        <ul class="plan">
          <li><strong>Goal:</strong> the satellite evidence reaches people who can act on it: city readers, the diaspora, journalists and NGOs. Not retweets for their own sake.</li>
          <li><strong>Where:</strong> X only for now. @GalamseyTracker posts, your own account quotes the best post of the week with one line in your words.</li>
          <li><strong>When:</strong> one post every weekday at 13:00 GMT. Monday a town, Wednesday a city's water, Friday the big numbers. Tuesday and Thursday a place in the news, because the numbers only change on Mondays.</li>
          <li><strong>Growth:</strong> a new account is seen mostly through others. Quoting the newsrooms' galamsey stories with the satellite picture of that place puts it in front of their readers.</li>
          <li><strong>Every post:</strong> one picture, one true fact, no question to readers, the link in the first reply, no blame and no names. "Likely galamsey" is our guess.</li>
          <li><strong>Judge it after four weeks:</strong> followers, views per post, and visits from X in Cloudflare Web Analytics. If news posts do better, post more of them.</li>
        </ul>
      </details>

      <p class="foot">{summary && <>Made from the satellite data up to {longDate(summary.data_date)}. </>}This page is private. Keep the address to yourself.</p>
    </section>
  </main>

  <script is:inline>
    const root = document.documentElement;
    const dark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const label = () => document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-label', dark() ? 'Switch to light mode' : 'Switch to dark mode'));
    label();
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', () => {
      root.dataset.theme = dark() ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      label();
    }));
    // A link to something inside a folded section opens it
    const open = () => { const t = location.hash && document.querySelector(location.hash); const d = t && t.closest('details'); if (d) d.open = true; };
    addEventListener('hashchange', open); open();
  </script>
  <script>
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      b.addEventListener('click', async () => {
        const text = b.closest('.copy')!.querySelector<HTMLElement>('[data-text]')!.innerText;
        try { await navigator.clipboard.writeText(text); b.textContent = 'Copied'; } catch { b.textContent = 'Select and copy'; }
        setTimeout(() => (b.textContent = 'Copy'), 2000);
      });
    }
  </script>

  <style>
    body { background: var(--paper); color: var(--ink); }
    .top { border-bottom: 1px solid var(--line); }
    .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-top: 10px; padding-bottom: 10px; }
    .brand { margin: 0; font-weight: 800; }
    .icon { font: inherit; color: var(--ink); background: transparent; cursor: pointer; display: inline-flex; align-items: center;
            justify-content: center; min-width: 44px; min-height: 44px; border: 1px solid var(--line); border-radius: 6px; padding: 0; }
    .icon:hover { border-color: var(--ink); }
    .theme .sun { display: none; }
    :root[data-theme='dark'] .theme .sun { display: block; }
    :root[data-theme='dark'] .theme .moon { display: none; }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme='light']) .theme .sun { display: block; }
      :root:not([data-theme='light']) .theme .moon { display: none; }
    }
    section { margin: 32px 0 48px; }
    h1 { margin: 0 0 6px; }
    .when { margin: 0 0 20px; font-size: 1.0625rem; }
    .today-grid { display: grid; gap: 24px; }
    @media (min-width: 900px) { .today-grid { grid-template-columns: minmax(0, 440px) minmax(0, 1fr); gap: 48px; align-items: start; } }
    .steps { border: 2px solid var(--ink); padding: 16px 20px; order: -1; }
    @media (min-width: 900px) { .steps { order: 0; } }
    .steps h2 { margin: 0 0 8px; font-size: 1.125rem; }
    .steps ol { margin: 0; padding-left: 1.25em; }
    .steps li { margin-bottom: 8px; }
    .extra { color: var(--signal); font-weight: 700; margin: 12px 0 0; }
    .slots .extra { margin: 0; }
    .slots { list-style: none; padding: 0; margin: 0; max-width: 70ch; }
    .slots li { display: grid; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line); }
    .day { font-weight: 700; }
    details { border-top: 1px solid var(--line); }
    details:last-of-type { border-bottom: 1px solid var(--line); }
    summary { cursor: pointer; font-weight: 700; padding: 14px 0; min-height: 44px; }
    details[open] { padding-bottom: 24px; }
    .note { color: var(--muted); max-width: 70ch; margin: 0 0 16px; }
    .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 40px 32px; margin-bottom: 24px; }
    .news { list-style: none; padding: 0; margin: 0; max-width: 70ch; }
    .news li { display: grid; gap: 2px; padding: 10px 0; border-bottom: 1px solid var(--line); }
    .meta { color: var(--muted); font-size: 0.9375rem; }
    .plan { max-width: 70ch; padding-left: 1.25em; margin: 0; }
    .plan li { margin-bottom: 10px; }
    .copy { display: grid; gap: 6px; margin-top: 12px; max-width: 70ch; }
    .head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .label { font-weight: 700; }
    [data-text] { white-space: pre-line; margin: 0; padding: 12px; border: 1px solid var(--line); font-size: 0.9375rem; }
    .foot { color: var(--muted); font-size: 0.9375rem; margin-top: 24px; }
  </style>
</body>
</html>
