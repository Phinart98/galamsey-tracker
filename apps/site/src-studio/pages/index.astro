---
// The private posting studio. Not linked from the site, noindex, robots disallow. Rebuilt every morning.
// One rule keeps it clear: every post on the page belongs to a day. This week's five days, then next week's.
import '../../src/styles/global.css';
import { summary } from '../../src/lib/data';
import { longDate } from '../../src/lib/format';
import { mondayOf, week, type Story } from '../lib/plan';
import { templates } from '../lib/templates';
import { news } from '../lib/news';
import PostCard from '../components/PostCard.astro';

const DAY = 864e5;
const now = new Date();
const today = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
const stories: Story[] = news.flatMap((n) => (n.match ? [{ date: n.date, title: n.title, link: n.link, source: n.source, post: n.match.post }] : []));
// On a weekend "this week" is the coming one
const weekend = today.getUTCDay() === 0 || today.getUTCDay() === 6;
const thisMonday = weekend ? new Date(mondayOf(today).getTime() + 7 * DAY) : mondayOf(today);
const weeks = [
  { id: 'this-week', name: weekend ? 'Next week' : 'This week', days: week(thisMonday, today, stories) },
  { id: 'next-week', name: weekend ? 'The week after' : 'Next week', days: week(new Date(thisMonday.getTime() + 7 * DAY), today, stories) },
];
const email = templates().find((t) => t.slug === 'email');
const todayName = today.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <title>Studio | Galamsey Tracker</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <meta name="color-scheme" content="light dark">
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
  </script>
</head>
<body>
  <header class="top">
    <div class="wrap bar">
      <p class="brand">Galamsey Tracker studio</p>
      <button class="icon theme" type="button" data-theme-toggle aria-label="Switch to dark mode">
        <svg class="moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
        <svg class="sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </header>

  <main class="wrap">
    <h1 data-built={today.toISOString().slice(0, 10)}>{todayName}</h1>
    <p class="note stale" hidden>This page was made on {todayName}. The days below have moved on to today, but the news check for today runs later this morning, so a news day may change. Refresh after it runs.</p>
    <p class="rule">One post every weekday at 13:00 from <strong>@GalamseyTracker</strong>. Tap a day to see its post.{weekend && <> No post today: weekends are off.</>}</p>

    {weeks.map((w) => (
      <section id={w.id}>
        <h2>{w.name}</h2>
        <ol class="days">
          {w.days.map((s) => (
            <li class:list={['day', s.status]} data-date={s.date}>
              {s.status === 'done' ? (
                <div class="row"><span class="when">{s.day}<span class="past">Past</span></span><span class="what">{s.title}</span>{s.email && <a class="extra" href="#email">This month's email, if not sent yet</a>}</div>
              ) : (
              <details open={s.status === 'today'}>
                <summary>
                  <span class="when">{s.day}{s.status === 'today' && <span class="tag">Today</span>}</span>
                  <span class="what">{s.title}</span>
                  {s.email && <span class="extra">Plus this month's email</span>}
                </summary>
                <div class="body">
                  {s.note && <p class="note">{s.note}</p>}
                  {s.email && <p class="note">Also send this month's email to one journalist or group: <a href="#email">the email template</a>.</p>}
                  {s.post && <div class="card-wrap"><PostCard post={s.post} story={s.story} level="h4" idPrefix={`${s.date}-`} /></div>}
                </div>
              </details>
              )}
            </li>
          ))}
        </ol>
      </section>
    ))}

    <section id="extras">
      <details id="email">
        <summary>The monthly email</summary>
        <p class="note">Once a month, to one journalist, NGO or researcher whose work fits. Change the first line to say why you picked them.</p>
        {email?.fields.map(([label, value]) => (
          <div class="copy"><div class="head"><span class="label">{label}</span><button type="button" class="btn" data-copy>Copy</button></div><p data-text>{value}</p></div>
        ))}
      </details>
      <details>
        <summary>How the plan works</summary>
        <ul class="plan">
          <li><strong>Goal:</strong> the satellite evidence reaches people who can act on it: city readers, the diaspora, journalists and NGOs. Not retweets for their own sake.</li>
          <li><strong>Where:</strong> X only for now. @GalamseyTracker posts. Your own account quotes the best post of the week with one line in your words.</li>
          <li><strong>The week:</strong> Monday a town, Wednesday a city's water, Friday the big numbers. Tuesday and Thursday a place in the news, picked that morning, because the numbers only change on Mondays.</li>
          <li><strong>Growth:</strong> a new account is seen mostly through others. Quoting the newsrooms' galamsey stories with the satellite picture of that place puts it in front of their readers.</li>
          <li><strong>Every post:</strong> one picture, one true fact, no question to readers, the link in the first reply, no blame and no names. "Likely galamsey" is our guess.</li>
          <li><strong>Judge it after four weeks:</strong> followers, views per post, and visits from X in Cloudflare Web Analytics.</li>
        </ul>
      </details>
      <p class="foot">{summary && <>Made from the satellite data up to {longDate(summary.data_date)}, and the news checked this morning. </>}This page is private. Keep the address to yourself.</p>
    </section>
  </main>

  <script is:inline>
    const root = document.documentElement;
    const dark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const label = () => document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.setAttribute('aria-label', dark() ? 'Switch to light mode' : 'Switch to dark mode'));
    label();
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', () => {
      root.dataset.theme = dark() ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      label();
    }));
    // A link to something inside a folded section opens it
    const open = () => { const t = location.hash && document.getElementById(decodeURIComponent(location.hash.slice(1))); const d = t && (t.tagName === 'DETAILS' ? t : t.closest('details')); if (d) d.open = true; };
    addEventListener('hashchange', open); open();
    // The page is built a few times a day, but GitHub can start a build hours late. If it was built on an earlier
    // day, move "Today" here: earlier days fold away as past, today opens. Ghana is on UTC all year.
    const h1 = document.querySelector('h1[data-built]');
    const now = new Date().toISOString().slice(0, 10);
    if (h1 && now > h1.dataset.built) {
      for (const li of document.querySelectorAll('li.day[data-date]')) {
        const d = li.dataset.date, det = li.querySelector('details');
        if (!det) continue;
        if (d < now) {
          li.classList.remove('today', 'ahead'); li.classList.add('done'); det.open = false;
          li.querySelector('.tag')?.remove();
          if (!li.querySelector('.past')) li.querySelector('.when')?.insertAdjacentHTML('beforeend', '<span class="past">Past</span>');
        } else if (d === now) {
          li.classList.remove('ahead'); li.classList.add('today'); det.open = true;
          if (!li.querySelector('.tag')) li.querySelector('.when')?.insertAdjacentHTML('beforeend', '<span class="tag">Today</span>');
        }
      }
      h1.textContent = new Date(now + 'T00:00:00Z').toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });
      const note = document.querySelector('.stale'); if (note) note.hidden = false;
    }
  </script>
  <script>
    for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
      b.addEventListener('click', async () => {
        const text = b.closest('.copy')!.querySelector<HTMLElement>('[data-text]')!.innerText;
        try { await navigator.clipboard.writeText(text); b.textContent = 'Copied'; } catch { b.textContent = 'Select and copy'; }
        setTimeout(() => (b.textContent = 'Copy'), 2000);
      });
    }
  </script>

  <style>
    body { background: var(--paper); color: var(--ink); }
    .top { border-bottom: 1px solid var(--line); }
    .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-top: 10px; padding-bottom: 10px; }
    .brand { margin: 0; font-weight: 800; }
    .icon { font: inherit; color: var(--ink); background: transparent; cursor: pointer; display: inline-flex; align-items: center;
            justify-content: center; min-width: 44px; min-height: 44px; border: 1px solid var(--line); border-radius: 6px; padding: 0; }
    .icon:hover { border-color: var(--ink); }
    .theme .sun { display: none; }
    :root[data-theme='dark'] .theme .sun { display: block; }
    :root[data-theme='dark'] .theme .moon { display: none; }
    @media (prefers-color-scheme: dark) {
      :root:not([data-theme='light']) .theme .sun { display: block; }
      :root:not([data-theme='light']) .theme .moon { display: none; }
    }
    main { padding-top: 28px; padding-bottom: 48px; }
    h1 { margin: 0 0 6px; }
    .rule { margin: 0 0 32px; max-width: 70ch; }
    section { margin-bottom: 40px; }
    h2 { margin: 0 0 8px; }

    .days { list-style: none; padding: 0; margin: 0; max-width: 960px; }
    .day { border-bottom: 1px solid var(--line); }
    .day:first-child { border-top: 1px solid var(--line); }
    .day.today { border: 2px solid var(--ink); margin: 6px 0; }
    .row { display: grid; gap: 2px; padding: 14px 12px 14px 40px; }
    .day summary { display: grid; gap: 2px; padding: 14px 12px 14px 40px; position: relative; cursor: pointer; list-style: none; min-height: 44px; }
    .day summary::-webkit-details-marker { display: none; }
    /* A plain chevron that turns when the day is open */
    .day summary::before { content: ''; position: absolute; left: 16px; top: 22px; width: 8px; height: 8px;
      border-right: 2px solid var(--ink); border-bottom: 2px solid var(--ink); transform: rotate(-45deg); transition: transform 160ms ease-out; }
    .day details[open] summary::before { transform: rotate(45deg); }
    @media (prefers-reduced-motion: reduce) { .day summary::before { transition: none; } }
    .when { font-weight: 700; display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; }
    .tag { font-size: 0.875rem; background: var(--ink); color: var(--paper); padding: 1px 8px; border-radius: 4px; }
    .past { font-size: 0.875rem; font-weight: 400; color: var(--muted); }
    .day.done .what { color: var(--muted); }
    .extra { color: var(--signal); font-weight: 700; }
    .body { padding: 0 12px 24px 40px; display: grid; gap: 16px; }
    .card-wrap { max-width: 420px; }
    .note { margin: 0; color: var(--muted); max-width: 60ch; }

    #extras details { border-top: 1px solid var(--line); max-width: 960px; }
    #extras details:last-of-type { border-bottom: 1px solid var(--line); }
    #extras summary { cursor: pointer; font-weight: 700; padding: 14px 0; min-height: 44px; }
    #extras details[open] { padding-bottom: 24px; }
    #extras .note { margin-bottom: 12px; }
    .plan { max-width: 70ch; padding-left: 1.25em; margin: 0; }
    .plan li { margin-bottom: 10px; }
    .copy { display: grid; gap: 6px; margin-top: 12px; max-width: 70ch; }
    .head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .label { font-weight: 700; }
    [data-text] { white-space: pre-line; margin: 0; padding: 12px; border: 1px solid var(--line); font-size: 0.9375rem; }
    .foot { color: var(--muted); font-size: 0.9375rem; margin-top: 24px; }
  </style>
</body>
</html>
