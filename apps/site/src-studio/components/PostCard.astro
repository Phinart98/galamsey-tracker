---
// One ready post: the picture, a button to save it, and the words to copy, in the order they are used on X
import type { Post } from '../lib/posts';
import type { Story } from '../lib/plan';

interface Props { post: Post; heading?: string; level?: 'h2' | 'h3' | 'h4'; textLabel?: string; idPrefix?: string; story?: Story | null }
const { post, heading, level = 'h3', textLabel = '1. The post', idPrefix = '', story = null } = Astro.props;
const H = level;
const fields: [string, string][] = [
  [textLabel, post.text],
  ['2. Image description (tap "Add description" on the picture)', post.alt],
  ['3. Your first reply to it, with the link', post.reply],
];
---
<article id={`${idPrefix}${post.slug}`} class="card">
  {heading && <H class="card-title">{heading}</H>}
  {story && (
    <div class="story">
      <p>The story: <a href={story.link} rel="noreferrer">{story.title}</a> ({story.source}). Check it is about this place first.</p>
      <p>Best: find the newsroom's own post of it on X (search the headline or their account), tap Repost, then Quote, and post this picture and text there. Their readers see it under their post. If you cannot find it, post it on its own: the text names the story and the first reply carries its link.</p>
    </div>
  )}
  <a href={`/${post.slug}.jpg`} class="pic"><img src={`/${post.slug}.jpg`} alt={post.alt} width="1080" height="1350" loading="lazy" decoding="async" /></a>
  <p class="save"><a class="btn" href={`/${post.slug}.jpg`} download={`galamsey-${post.slug}.jpg`}>Save the picture</a></p>
  {fields.map(([label, value]) => (
    <div class="copy">
      <div class="head"><span class="label">{label}</span><button type="button" class="btn" data-copy>Copy</button></div>
      <p data-text>{value}</p>
    </div>
  ))}
</article>

<style>
  /* Grid items default to min-width: auto, so one long link (news links run 300 characters) would set the
     column width and push the page wider than a phone. min-width: 0 plus overflow-wrap lets it wrap. */
  .card { display: grid; gap: 12px; align-content: start; }
  .card > *, .story > *, .copy > * { min-width: 0; }
  .card-title { margin: 0; }
  .pic img { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
  .save { margin: 0; }
  .story { margin: 0; padding: 12px; border: 2px solid var(--ink); display: grid; gap: 8px; overflow-wrap: anywhere; }
  .story p { margin: 0; }
  .copy { display: grid; gap: 6px; }
  .head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .label { font-weight: 700; }
  [data-text] { white-space: pre-line; overflow-wrap: anywhere; margin: 0; padding: 12px; border: 1px solid var(--line); font-size: 0.9375rem; }
</style>
