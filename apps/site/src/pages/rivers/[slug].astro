  .marks :global(.edge.l) { left: 0; border-radius: 0 3px 3px 0; }
  .marks :global(.edge.r) { right: 0; border-radius: 3px 0 0 3px; }
  .marks :global(.tag) { left: 8px; transform: translateY(-50%); font-size: 0.875rem; font-weight: 700; padding: 3px 8px; border-radius: 3px; background: #1D5C8C; color: #fff; max-width: calc(100% - 16px); white-space: normal; line-height: 1.35; }
  .marks :global(.tag.r) { left: auto; right: 8px; }
  .marks :global(.tag.plant) { background: #000; }
  .marks :global(a.tag) { text-decoration: underline; min-height: 32px; display: inline-flex; align-items: center; }
  .marks :global(.stub) { height: 3px; width: 30%; background: #7DB8E8; transform: translateY(-50%); }
  .marks :global(.tick) { left: 4px; transform: translateY(-50%); font-size: 0.75rem; font-weight: 700; color: #fff; background: rgba(0, 0, 0, 0.72); padding: 1px 6px; border-radius: 3px; }
  .marks :global(.zone) { left: 0; right: 0; height: 0; border-top: 2px dashed #fff; }
  .marks :global(.zone span) { position: absolute; left: 8px; right: 8px; top: 4px; font-size: 0.8125rem; font-weight: 700; background: #000; color: #fff; padding: 2px 8px; border-radius: 3px; }
  .marks :global(.ring) { transform: translate(-50%, -50%); border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 0 1px #000, inset 0 0 0 1px #000; background: none; padding: 0; cursor: pointer; min-width: 24px; min-height: 24px; }
  .marks :global(.ring.likely) { border-color: #FF3D8B; }
