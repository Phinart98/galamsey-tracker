  :global(.loc .this) { fill: none; stroke: var(--river); stroke-width: 2.4; stroke-linejoin: round; }
  :global(.loc .seen) { fill: none; stroke: var(--ink); stroke-width: 3; stroke-linecap: round; stroke-linejoin: round; }
  :global(.loc .dot) { fill: var(--signal); stroke: var(--paper); stroke-width: 1.5; }

  .river { position: relative; overflow: clip; max-width: 520px; margin: 0 auto; width: 100%; background: #3d4a37; }
  .river img { display: block; width: 100%; height: auto; }
  .marks { position: absolute; inset: 0; pointer-events: none; }
