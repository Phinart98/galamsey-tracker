  .mapsheet .km { margin-top: 12px; }
  .mapsheet .near { white-space: normal; }
  /* Square, so a tap's position maps straight onto the drawing */
  .mapsheet svg { aspect-ratio: 1; width: min(100%, calc(100dvh - 140px)); height: auto; margin: 0 auto; cursor: crosshair; border: 1px solid var(--line); }
