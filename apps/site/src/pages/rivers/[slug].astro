  .note { padding-top: 32px; }
  .note h2 { font-size: 1.25rem; margin: 0 0 8px; }
  .note p { max-width: 65ch; }

  /* The place card: over the foot of the screen on phones, in the right column on wide screens */
  .card { position: fixed; left: 8px; right: 8px; bottom: 8px; z-index: 8; max-width: 440px; max-height: 78dvh; overflow: auto; margin: 0 auto;
    background: var(--paper); border: 2px solid var(--ink); border-radius: 8px; padding: 12px 14px 16px; }
  .card :global(.chead) { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .card :global(h3) { margin: 0; font-size: 1.25rem; }
  .card :global(p) { margin: 8px 0; }
  .card :global(.tags) { display: flex; flex-wrap: wrap; gap: 6px; }
  .card :global(.mini) { margin: 8px 0 12px; display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .card :global(.mini a) { text-decoration: none; display: block; }
  .card :global(.mini img) { width: 100%; background: var(--paper-2); }
  .card :global(.when) { display: block; font-size: 0.875rem; margin-top: 4px; }
  .card :global(.mini a:hover .when) { text-decoration: underline; }

  .mapsheet { width: min(100vw, 640px); max-width: 100vw; max-height: 100dvh; padding: 12px var(--gutter) 20px; border: 0; border-radius: 0; background: var(--paper); color: var(--ink); }
  .mapsheet::backdrop { background: rgba(0, 0, 0, 0.6); }
