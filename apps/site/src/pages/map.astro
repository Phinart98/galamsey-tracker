    font: inherit; font-weight: 700; color: var(--ink); background: transparent; cursor: pointer; flex: none;
    min-height: 44px; padding: 0 12px; border: 1px solid var(--ink); border-radius: 6px;
  }
  .detail :global(.mini) { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; margin: 0; }
  .detail :global(.mini a) { display: block; text-decoration: none; }
