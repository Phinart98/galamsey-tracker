---
import Base from '../layouts/Base.astro';
import LabelKey from '../components/LabelKey.astro';
import PlaceRow from '../components/PlaceRow.astro';
import { active, coverage, hasPair, summary, tiles } from '../lib/data';
import { district, longDate, num } from '../lib/format';
import maplibre from '../../.data/maplibre.json';

const LIST = 60;
const bounds = Object.values(tiles).map((t) => t.bounds).filter(Boolean);
const box = bounds.length
  ? [Math.min(...bounds.map((b) => b[0])), Math.min(...bounds.map((b) => b[1])), Math.max(...bounds.map((b) => b[2])), Math.max(...bounds.map((b) => b[3]))]
  : [-3.3, 4.7, -0.3, 7.5];
const counts = new Map<string, number>();
for (const p of active) if (p.district) counts.set(p.district, (counts.get(p.district) ?? 0) + 1);
const districts = [...counts].map(([raw, n]) => ({ raw, n, label: district({ district: raw } as any)! }))
  .sort((a, b) => a.label.localeCompare(b.label));
// One row of each kind, cloned by the filter script so its rows match the built ones exactly
const withPic = active.find(hasPair);
const withoutPic = active.find((p) => !hasPair(p));
---
<Base title="Map of cleared land" description="Every patch of land of at least 1 hectare that lost its plant cover in the last 12 months, with the licence on the land.">
  <div class="sheet wrap">
    <aside class="margin">
      <h1>Every patch cleared in the last 12 months</h1>
      <p class="muted small">Covers <a href="/method#covers">{coverage.length === 1 ? coverage[0] : `${coverage.length} areas of the southern gold belt`}</a>.</p>
      {summary && (
        <dl class="facts small">
          <dt>Patches</dt><dd>{num(summary.patches)} of at least 1 hectare</dd>
          <dt>Total</dt><dd>{num(summary.total_ha)} hectares</dd>
          <><dt>Checked</dt><dd>About 4 in 5 hectares showed signs of mining in a random check. <a href="/method#mining">How we checked</a></dd></>
          <dt>Data up to</dt><dd>{longDate(summary.data_date)}</dd>
        </dl>
      )}
      <div class="fwrap" data-fwrap hidden>
      <button class="ftoggle" type="button" aria-expanded="false" aria-controls="filters" data-ftoggle>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="16" cy="6" r="2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="10" cy="12" r="2" fill="none" stroke="currentColor" stroke-width="2"/><circle cx="18" cy="18" r="2" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        <span class="flabel">Filters</span>
        <span class="fbadge" data-fbadge hidden></span>
        <svg class="chev" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </button>
      <h2 class="fh">Filter the places</h2>
      <form class="filters" id="filters" data-filters hidden>
        <label>Town or village
          <input name="town" list="town-options" autocomplete="off" spellcheck="false" placeholder="Type a name" data-town />
          <datalist id="town-options" data-town-options></datalist>
        </label>
        <label>Licence on the land
          <select name="licence">
            <option value="">Any licence or none</option>
            <option value="alarm">No licence to mine</option>
            <option value="none">No licence at all</option>
            <option value="prospecting">Prospecting licence only</option>
            <option value="small">Small-scale mining licence</option>
            <option value="large">Large-scale mining lease</option>
          </select>
        </label>
        <label>District
          <select name="district">
            <option value="">All districts</option>
            {districts.map((d) => <option value={d.raw}>{d.label} ({num(d.n)})</option>)}
          </select>
        </label>
        <label>First seen
          <select name="since">
            <option value="">Any time in the last 12 months</option>
            <option value="90">In the last 3 months</option>
            <option value="30">In the last month</option>
          </select>
        </label>
        <label>Size
          <select name="min">
            <option value="">Any size</option>
            <option value="5">5 hectares or more</option>
            <option value="20">20 hectares or more</option>
            <option value="50">50 hectares or more</option>
          </select>
        </label>
        <label class="check"><input type="checkbox" name="pics" value="1"> Only places with pictures</label>
        <label>Order of the list
          <select name="sort">
            <option value="">Largest first</option>
            <option value="new">Newest first</option>
          </select>
        </label>
        <p class="count" data-count aria-live="polite"></p>
        <button class="btn" type="reset" data-clear hidden>Clear filters</button>
      </form>
      </div>
    </aside>

    <div class="mapcol">
      <button class="btn primary open" type="button" data-open-map>Show on map</button>
      <div class="frame" data-frame hidden>
        <div class="maphead">
          <span class="small"><strong data-map-count></strong> <span class="muted">© OpenStreetMap, OpenFreeMap</span></span>
          <button class="btn close" type="button" data-close-map>Back to list</button>
        </div>
        <div class="mapbox">
          <div id="map" data-map data-lib={maplibre.base} data-bounds={JSON.stringify(box)} data-site={import.meta.env.SITE} role="region" aria-label="Map of cleared land"></div>
          <p class="tip" data-tip hidden></p>
          <p class="loading" data-loading role="status">Loading {num(active.length)} places</p>
          <div class="detail" data-detail hidden></div>
        </div>
        <div class="mapfoot small">
          <ul class="key" aria-label="Map key">
            <li><span class="sw alarm"></span>No licence to mine</li>
            <li><span class="sw ring"></span>Inside a mining licence</li>
            <li><span class="sw area"></span>Area we have covered</li>
          </ul>
          <p class="muted">Bigger circles, bigger patches. Tap one to see it.</p>
        </div>
      </div>
    </div>

    <section class="listcol" aria-labelledby="list-h">
      <h2 id="list-h" data-list-h>Largest first</h2>
      <p class="muted small"><span data-list-note>The {Math.min(LIST, active.length)} largest of {num(active.length)} patches.</span> <a href="/places.csv">Download all of them</a>.</p>
      <LabelKey />
      <ul class="list" data-list data-date={summary?.data_date}>{active.slice(0, LIST).map((p) => <PlaceRow place={p} />)}</ul>
      <button class="btn" type="button" data-more hidden={active.length <= LIST}>Show {LIST} more</button>
      {withPic && <template data-row="pic"><PlaceRow place={withPic} /></template>}
      {withoutPic && <template data-row="nopic"><PlaceRow place={withoutPic} /></template>}
    </section>
  </div>
</Base>

<script>
  import type { Map as MLMap, GeoJSONSource } from 'maplibre-gl';
  import { NO_PICTURE, googleMaps, type NoPicture } from '../lib/format';

  const el = document.querySelector<HTMLElement>('[data-map]')!;
  const frame = document.querySelector<HTMLElement>('[data-frame]')!;
  const openBtn = document.querySelector<HTMLButtonElement>('[data-open-map]')!;
  const detail = document.querySelector<HTMLElement>('[data-detail]')!;
  const loading = document.querySelector<HTMLElement>('[data-loading]')!;
  const tip = document.querySelector<HTMLElement>('[data-tip]')!;
  const site = el.dataset.site!.replace(/\/$/, '');
  const box = JSON.parse(el.dataset.bounds!) as [number, number, number, number];
  let map: MLMap | null = null;

  const css = (n: string) => getComputedStyle(document.documentElement).getPropertyValue(n).trim();
  const isDark = () => {
    const t = document.documentElement.dataset.theme;
    return t ? t === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  };
  const style = () => `https://tiles.openfreemap.org/styles/${isDark() ? 'dark' : 'positron'}`;
  const local = (u: string) => (u.startsWith(site) ? u.slice(site.length) : u);
  const long = (iso: string) => new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
  const ALARM = ['no licence', 'prospecting only'];
  const LABEL: Record<string, string> = {
    'no licence': 'No licence to mine', 'prospecting only': 'Prospecting licence only',
    'small-scale licence': 'Small-scale mining licence', 'large-scale lease': 'Large-scale mining lease',
  };

  function addData(m: MLMap) {
    const [w, s, e, n] = box;
    m.addSource('area', { type: 'geojson', data: { type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [[[w, s], [e, s], [e, n], [w, n], [w, s]]] } } });
    m.addLayer({ id: 'area', type: 'line', source: 'area', paint: { 'line-color': css('--ink'), 'line-width': 1.5, 'line-dasharray': [3, 2] } });
    m.addSource('places', { type: 'geojson', data: '/places.geojson', promoteId: 'id' });
    m.addLayer({
      id: 'places', type: 'circle', source: 'places',
      paint: {
        'circle-radius': ['interpolate', ['linear'], ['sqrt', ['get', 'ha']], 1, 3, 11, 20],
        'circle-color': ['case', ['in', ['get', 'licence'], ['literal', ALARM]], css('--signal'), 'rgba(0,0,0,0)'],
        'circle-stroke-color': ['case', ['any', ['boolean', ['feature-state', 'picked'], false], ['boolean', ['feature-state', 'hover'], false]], css('--ink'),
          ['in', ['get', 'licence'], ['literal', ALARM]], css('--paper'), css('--ink')],
        'circle-stroke-width': ['case', ['any', ['boolean', ['feature-state', 'picked'], false], ['boolean', ['feature-state', 'hover'], false]], 3, ['in', ['get', 'licence'], ['literal', ALARM]], 0.75, 2],
        'circle-opacity': 0.9,
      },
    });
    m.setFilter('places', mapFilter);
    m.addSource('town', { type: 'geojson', data: { type: 'FeatureCollection', features: [] } });
    m.addLayer({ id: 'town', type: 'line', source: 'town', paint: { 'line-color': css('--ink'), 'line-width': 2, 'line-dasharray': [2, 1.5] } });
    showTown(m);
  }

  // The chosen town's 1 km ring, and the map moved to it
  function showTown(m: MLMap) {
    const src = m.getSource('town') as GeoJSONSource | undefined;
    if (!src) return;
    if (!town) { src.setData({ type: 'FeatureCollection', features: [] }); return; }
    const dLat = 1000 / 111320, dLon = dLat / Math.cos((town.lat * Math.PI) / 180);
    const ring = Array.from({ length: 65 }, (_, i) => {
      const a = (i / 64) * 2 * Math.PI;
      return [town!.lon + dLon * Math.cos(a), town!.lat + dLat * Math.sin(a)];
    });
    src.setData({ type: 'Feature', properties: {}, geometry: { type: 'Polygon', coordinates: [ring] } });
    m.fitBounds([[town.lon - dLon * 1.6, town.lat - dLat * 1.6], [town.lon + dLon * 1.6, town.lat + dLat * 1.6]], { duration: still() ? 0 : 600 });
  }

  let picked: string | null = null;
  const phone = () => matchMedia('(max-width: 959px)').matches;
  const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  function unpick() {
    if (map && picked) map.setFeatureState({ source: 'places', id: picked }, { picked: false });
    map?.setPadding({ top: 0, left: 0, right: 0, bottom: 0 });
    picked = null;
    detail.hidden = true;
    history.replaceState(null, '', location.pathname);
  }

  function pick(m: MLMap, f: GeoJSON.Feature<GeoJSON.Point>, zoom?: number) {
    const p = f.properties as Record<string, any>;
    if (picked) m.setFeatureState({ source: 'places', id: picked }, { picked: false });
    picked = p.id;
    m.setFeatureState({ source: 'places', id: p.id }, { picked: true });
    detail.replaceChildren();
    const title = `${hectares(p.ha)} cleared ${p.name}`;
    const head = document.createElement('div');
    head.className = 'dhead';
    const h = document.createElement('h2');
    h.textContent = title;
    const hide = document.createElement('button');
    hide.type = 'button'; hide.className = 'hide'; hide.textContent = 'Close';
    hide.setAttribute('aria-label', 'Close this place');
    hide.addEventListener('click', unpick);
    head.append(h, hide);
    detail.append(head);
    if (p.before_image) {
      // A pair the picture viewer understands, so tapping a picture opens it large
      const pair = document.createElement('figure');
      pair.className = 'mini';
      const [plon, plat] = f.geometry.coordinates;
      Object.assign(pair.dataset, { pair: '', title, href: `/places/${p.id}`, lat: String(plat), lon: String(plon) });
      for (const side of ['before', 'after']) {
        const small = local(p[`${side}_image`]);
        const large = small.replace(/-360\.webp$/, '-720.webp');
        pair.dataset[side] = large;
        pair.dataset[`${side}Date`] = long(p[`${side}_date`]);
        const a = document.createElement('a');
        a.href = large; a.dataset.open = side;
        const img = document.createElement('img');
        img.src = small; img.width = 360; img.height = 360;
        img.alt = `Satellite image, ${side}, ${long(p[`${side}_date`])}`;
        const cap = document.createElement('span');
        cap.textContent = short(p[`${side}_date`]);
        a.append(img, cap);
        pair.append(a);
      }
      detail.append(pair);
    } else {
      const none = document.createElement('p');
      none.className = 'muted small';
      none.textContent = NO_PICTURE[p.no_picture as NoPicture] ?? NO_PICTURE.pending;
      detail.append(none);
    }
    const lic = document.createElement('p');
    lic.textContent = `${LABEL[p.licence]}. First seen ${long(p.first_seen)}.`;
    const link = document.createElement('a');
    link.href = `/places/${p.id}`; link.textContent = 'Open this place';
    link.className = 'btn';
    const [lon, lat] = f.geometry.coordinates as [number, number];
    const google = document.createElement('a');
    google.href = googleMaps(lat, lon); google.target = '_blank'; google.rel = 'noopener noreferrer';
    google.textContent = 'Closer on Google Maps (may be older)';
    google.className = 'google';
    detail.append(lic, link, google);
    detail.hidden = false;
    history.replaceState(null, '', `#${p.id}`);
    // On a phone the panel covers the lower half, so centre the place in the part still showing
    m.easeTo({
      center: f.geometry.coordinates as [number, number], zoom: zoom ?? Math.max(m.getZoom(), 11),
      padding: { top: 0, left: phone() ? 0 : detail.offsetWidth + 24, right: 0, bottom: phone() ? detail.offsetHeight : 0 },
      duration: still() ? 0 : 400,
    });
  }

  async function open() {
    frame.hidden = false;
    openBtn.hidden = true;
    document.body.classList.add('map-open');
    if (map) { map.resize(); return; }
    const lib = el.dataset.lib!;
    const sheet = document.createElement('link');
    sheet.rel = 'stylesheet'; sheet.href = `${lib}/maplibre-gl.css`;
    document.head.append(sheet);
    const maplibregl: typeof import('maplibre-gl') = await import(/* @vite-ignore */ `${lib}/maplibre-gl.mjs`);
    const m = new maplibregl.Map({
      container: el, style: style(), bounds: [[box[0], box[1]], [box[2], box[3]]], fitBoundsOptions: { padding: 24 },
      attributionControl: false, cooperativeGestures: false,
    });
    map = m;
    m.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
    m.addControl(new maplibregl.ScaleControl({ unit: 'metric' }), 'bottom-left');
    m.on('sourcedata', (e) => {
      if (e.sourceId === 'places' && m.isSourceLoaded('places')) loading.hidden = true;
    });
    m.on('load', () => {
      addData(m);
      const want = decodeURIComponent(location.hash.slice(1));
      if (want) {
        m.once('idle', () => {
          const src = m.getSource('places') as GeoJSONSource;
          src.getData().then((fc: any) => {
            const f = fc.features.find((x: any) => x.properties.id === want);
            if (f) pick(m, f, 13);
          });
        });
      }
    });
    // Small circles are hard to hit, especially with a finger, so look a few pixels around the point
    const near = (pt: { x: number; y: number }) => {
      const r = phone() ? 14 : 6;
      const found = m.getLayer('places') ? m.queryRenderedFeatures([[pt.x - r, pt.y - r], [pt.x + r, pt.y + r]], { layers: ['places'] }) : [];
      return found.length ? found.reduce((a, b) => (b.properties!.ha > a.properties!.ha ? b : a)) : null;
    };
    let hovered: string | null = null;
    const unhover = () => {
      if (hovered) m.setFeatureState({ source: 'places', id: hovered }, { hover: false });
      hovered = null;
      tip.hidden = true;
      m.getCanvas().style.cursor = '';
    };
    m.on('click', (e) => {
      const f = near(e.point);
      if (f) pick(m, f as unknown as GeoJSON.Feature<GeoJSON.Point>);
    });
    m.on('mousemove', (e) => {
      const f = near(e.point);
      if (!f) return unhover();
      const p = f.properties as Record<string, any>;
      if (hovered !== p.id) {
        unhover();
        hovered = p.id;
        m.setFeatureState({ source: 'places', id: p.id }, { hover: true });
        tip.textContent = `${hectares(p.ha)} cleared ${p.name}. ${p.before_image ? 'Click to see the pictures.' : 'Click for details.'}`;
      }
      tip.hidden = false;
      tip.style.translate = `${Math.min(e.point.x + 14, el.clientWidth - tip.offsetWidth - 8)}px ${Math.max(e.point.y - tip.offsetHeight - 10, 8)}px`;
      m.getCanvas().style.cursor = 'pointer';
    });
    m.on('mouseout', unhover);
    m.on('movestart', unhover);
    addEventListener('themechange', () => {
      m.setStyle(style(), { diff: false });
      m.once('style.load', () => {
        addData(m);
        if (picked) m.setFeatureState({ source: 'places', id: picked }, { picked: true });
      });
    });
  }

  function close() {
    frame.hidden = true;
    openBtn.hidden = false;
    document.body.classList.remove('map-open');
    openBtn.focus();
  }

  // Filters: shared by the list and the map, and kept in the address so a filtered view can be shared
  type Props = Record<string, any>;
  const form = document.querySelector<HTMLFormElement>('[data-filters]')!;
  const list = document.querySelector<HTMLUListElement>('[data-list]')!;
  const more = document.querySelector<HTMLButtonElement>('[data-more]')!;
  const note = document.querySelector<HTMLElement>('[data-list-note]')!;
  const listHead = document.querySelector<HTMLElement>('[data-list-h]')!;
  const count = document.querySelector<HTMLElement>('[data-count]')!;
  const mapCount = document.querySelector<HTMLElement>('[data-map-count]')!;
  const PAGE = 60;
  const LICENCES: Record<string, string[]> = {
    alarm: ALARM, none: ['no licence'], prospecting: ['prospecting only'],
    small: ['small-scale licence'], large: ['large-scale lease'],
  };
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const short = (iso: string) => { const [y, mo, d] = iso.split('-').map(Number); return `${d} ${MONTHS[mo - 1]} ${y}`; };
  const fmt = new Intl.NumberFormat('en-GB');
  const hectares = (ha: number) => (ha < 10 ? `${ha.toFixed(1)} hectares` : `${fmt.format(Math.round(ha))} hectares`);
  let mapFilter: any = null;
  let places: Promise<Props[]> | null = null;
  let shown: Props[] = [];
  let upTo = PAGE;
  // The first page of the list is written at build time; the full list loads only when it is needed
  let ready = false;

  type Town = { key: string; ids: Set<string>; lat: number; lon: number };
  let towns: Promise<Map<string, Town>> | null = null;
  let town: Town | null = null;
  const loadTowns = () => (towns ??= fetch('/towns.json').then((r) => r.json()).then((rows: [string, string | null, number, number, string[], number, number][]) =>
    new Map(rows.map(([name, dist, , , ids, lat, lon]) => {
      const key = dist ? `${name} (${dist})` : name;
      return [key, { key, ids: new Set(ids), lat, lon }];
    }))));
  const townInput = document.querySelector<HTMLInputElement>('[data-town]')!;
  townInput.addEventListener('focus', async () => {
    const options = document.querySelector('[data-town-options]')!;
    if (options.childElementCount) return;
    options.replaceChildren(...[...(await loadTowns()).keys()].map((k) => Object.assign(document.createElement('option'), { value: k })));
  }, { once: true });

  const load = () => (places ??= fetch('/places.geojson').then((r) => r.json()).then((fc) => fc.features.map((f: any) => ({ ...f.properties, lon: f.geometry.coordinates[0], lat: f.geometry.coordinates[1] }))));

  function wanted() {
    const f = new FormData(form);
    const get = (k: string) => String(f.get(k) ?? '');
    const days = Number(get('since'));
    const cutoff = days ? new Date(Date.parse(`${list.dataset.date}T00:00:00Z`) - days * 864e5).toISOString().slice(0, 10) : '';
    return { town: get('town').trim(), licence: get('licence'), district: get('district'), cutoff, min: Number(get('min')) || 0, pics: get('pics') === '1', sort: get('sort') };
  }
  type Wanted = ReturnType<typeof wanted>;

  const matches = (w: Wanted) => (p: Props) => (!w.town || !!town?.ids.has(p.id))
    && (!w.licence || LICENCES[w.licence].includes(p.licence))
    && (!w.district || p.district === w.district)
    && (!w.cutoff || p.first_seen >= w.cutoff)
    && p.ha >= w.min
    && (!w.pics || !!p.before_image);

  function expression(w: Wanted) {
    const all: any[] = ['all'];
    if (w.town) all.push(['in', ['get', 'id'], ['literal', town ? [...town.ids] : []]]);
    if (w.licence) all.push(['in', ['get', 'licence'], ['literal', LICENCES[w.licence]]]);
    if (w.district) all.push(['==', ['get', 'district'], w.district]);
    if (w.cutoff) all.push(['>=', ['get', 'first_seen'], w.cutoff]);
    if (w.min) all.push(['>=', ['get', 'ha'], w.min]);
    if (w.pics) all.push(['has', 'before_image']);
    return all.length > 1 ? all : null;
  }

  function row(p: Props) {
    const tpl = document.querySelector<HTMLTemplateElement>(`[data-row=${p.before_image ? 'pic' : 'nopic'}]`)!;
    const li = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const title = `${hectares(p.ha)} cleared ${p.name}`;
    const a = li.querySelector<HTMLAnchorElement>('h3 a')!;
    a.href = `/places/${p.id}`; a.textContent = title;
    li.querySelector('.text p')!.textContent = `First seen ${long(p.first_seen)}.`;
    const tag = li.querySelector<HTMLElement>('.tag')!;
    tag.classList.toggle('alarm', ALARM.includes(p.licence));
    tag.classList.toggle('plain', !ALARM.includes(p.licence));
    tag.textContent = LABEL[p.licence];
    const none = li.querySelector('.nopair');
    if (none) none.textContent = NO_PICTURE[p.no_picture as NoPicture] ?? NO_PICTURE.pending;
    const fig = li.querySelector<HTMLElement>('[data-pair]');
    if (fig) {
      Object.assign(fig.dataset, { title, href: `/places/${p.id}`, lat: String(p.lat), lon: String(p.lon) });
      li.querySelectorAll<HTMLAnchorElement>('[data-open]').forEach((shot) => {
        const side = shot.dataset.open!;
        const small = local(p[`${side}_image`]);
        const file = (size: string) => small.replace(/-360\.webp$/, `-${size}`);
        fig.dataset[side] = file('720.webp');
        fig.dataset[`${side}Date`] = long(p[`${side}_date`]);
        shot.href = file('720.webp');
        shot.querySelector('source')!.srcset = `${file('360.avif')} 360w, ${file('720.avif')} 720w`;
        const img = shot.querySelector('img')!;
        img.src = small; img.srcset = `${small} 360w, ${file('720.webp')} 720w`;
        img.loading = 'lazy'; img.removeAttribute('fetchpriority');
        img.alt = side === 'before'
          ? `Satellite image of the place on ${long(p.before_date)}, before the clearing was first seen`
          : `Satellite image of the same place on ${long(p.after_date)}`;
        shot.querySelector('.when')!.textContent = short(p[`${side}_date`]);
      });
    }
    return li;
  }

  function paint() {
    list.replaceChildren(...shown.slice(0, upTo).map(row));
    more.hidden = shown.length <= upTo;
  }

  async function apply() {
    const w = wanted();
    town = w.town ? (await loadTowns()).get(w.town) ?? null : null;
    if (map) showTown(map);
    const q = new URLSearchParams();
    for (const [k, v] of new FormData(form)) if (v) q.set(k, String(v));
    history.replaceState(null, '', `${location.pathname}${q.size ? `?${q}` : ''}${location.hash}`);
    mapFilter = expression(w);
    if (map?.getLayer('places')) map.setFilter('places', mapFilter);
    const all = await load();
    shown = all.filter(matches(w));
    shown.sort(w.sort === 'new'
      ? (a, b) => (a.first_seen === b.first_seen ? b.ha - a.ha : a.first_seen < b.first_seen ? 1 : -1)
      : (a, b) => b.ha - a.ha);
    const ha = shown.reduce((t, p) => t + p.ha, 0);
    const everything = shown.length === all.length;
    count.textContent = town && shown.length
      ? `${fmt.format(shown.length)} ${shown.length === 1 ? 'patch reaches' : 'patches reach'} within 1 km of ${town.key}, ${fmt.format(Math.round(ha))} hectares. A big patch can reach the ring even when its dot sits outside it.`
      : everything
      ? `Showing all ${fmt.format(all.length)} patches.`
      : shown.length
        ? `${fmt.format(shown.length)} of ${fmt.format(all.length)} patches match, ${fmt.format(Math.round(ha))} hectares in all.`
        : w.town && !town ? 'No cleared land within 1 km of a place with that name. Pick a name from the list.' : 'No patches match. Try fewer filters.';
    mapCount.textContent = everything ? '' : `${fmt.format(shown.length)} shown.`;
    listHead.textContent = w.sort === 'new' ? 'Newest first' : 'Largest first';
    note.textContent = shown.length
      ? `${shown.length > PAGE ? `The first ${PAGE} of ` : ''}${fmt.format(shown.length)} ${everything ? '' : 'matching '}patches.`
      : 'No patches match.';
    upTo = PAGE;
    paint();
    ready = true;
  }

  const params = new URLSearchParams(location.search);
  for (const el of Array.from(form.elements) as HTMLInputElement[]) {
    const v = params.get(el.name);
    if (v == null) continue;
    if (el.type === 'checkbox') el.checked = v === el.value; else el.value = v;
  }
  const toggle = document.querySelector<HTMLButtonElement>('[data-ftoggle]')!;
  const badge = document.querySelector<HTMLElement>('[data-fbadge]')!;
  const clear = document.querySelector<HTMLButtonElement>('[data-clear]')!;
  const wide = matchMedia('(min-width: 960px)');
  const setOpen = (open: boolean) => {
    form.hidden = !open;
    toggle.setAttribute('aria-expanded', String(open));
  };
  // On desktop the filters are always shown; on phones they fold away so the list starts near the top
  wide.addEventListener('change', () => setOpen(wide.matches || toggle.getAttribute('aria-expanded') === 'true'));
  toggle.addEventListener('click', () => setOpen(form.hidden));
  const markActive = () => {
    const on = [...new FormData(form)].filter(([k, v]) => v && k !== 'sort').length;
    badge.hidden = on === 0;
    badge.textContent = `${on} on`;
    clear.hidden = on === 0;
  };
  form.addEventListener('change', markActive);
  form.addEventListener('reset', () => setTimeout(markActive));
  (document.querySelector('[data-fwrap]') as HTMLElement).hidden = false;
  form.addEventListener('change', apply);
  form.addEventListener('submit', (e) => e.preventDefault());
  form.addEventListener('reset', () => setTimeout(apply));
  more.addEventListener('click', async () => {
    if (!ready) await apply();
    const first = upTo;
    upTo += PAGE;
    paint();
    list.children[first]?.querySelector<HTMLAnchorElement>('h3 a')?.focus();
  });
  const filtered = [...params.keys()].some((k) => form.elements.namedItem(k));
  // On phones the filters fold away so the list starts near the top
  setOpen(wide.matches);
  markActive();
  if (filtered) apply();

  openBtn.addEventListener('click', open);
  document.querySelector('[data-close-map]')!.addEventListener('click', close);
  if (matchMedia('(min-width: 960px)').matches || location.hash.length > 1) open();
</script>

<style>
