  .mapcol { grid-area: map; }
  .listcol { grid-area: list; }
  /* Desktop: the panel and the list scroll with the page while the map stays in view beside them */
  @media (min-width: 960px) {
    .sheet { grid-template-columns: minmax(340px, 400px) 1fr; grid-template-areas: 'margin map' 'list map'; column-gap: 32px; row-gap: 8px; }
    /* Short enough to show whole below the header, so the key at its foot is never cut off */
    .mapcol { position: sticky; top: 16px; align-self: start; height: calc(100dvh - 110px); min-height: 480px; }
    .mapcol .frame { height: 100%; display: flex; flex-direction: column; }
