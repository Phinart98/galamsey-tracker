    border: 1px solid var(--ink); border-radius: 6px; text-align: left;
  }
  .ftoggle .flabel { flex: 1; }
  .ftoggle .chev { transition: rotate 150ms ease-out; }
  .ftoggle[aria-expanded='true'] .chev { rotate: 180deg; }
  .ftoggle[aria-expanded='true'] { border-bottom-left-radius: 0; border-bottom-right-radius: 0; }
  @media (prefers-reduced-motion: reduce) { .ftoggle .chev { transition: none; } }
  .fbadge { background: var(--ink); color: var(--paper); font-size: 0.8125rem; padding: 1px 8px; border-radius: 4px; }
  .fbadge[hidden] { display: none; }
  .fh { display: none; font-size: 1.125rem; margin: 0 0 4px; }
  @media (min-width: 960px) { .ftoggle { display: none; } .fh { display: block; } }
  .filters { display: grid; gap: 12px; padding: 12px 0 4px; }
  .filters[hidden] { display: none; }
  @media (max-width: 959px) {
    .filters { border: 1px solid var(--ink); border-top: 0; border-radius: 0 0 6px 6px; padding: 14px; }
  }
  .filters label { display: grid; gap: 4px; font-size: 0.9375rem; font-weight: 700; }
  .filters select, .filters input[name="town"] {
    font: inherit; font-weight: 400; min-height: 44px; padding: 0 10px; width: 100%; min-width: 0;
    color: var(--ink); background: var(--paper); border: 1px solid var(--ink); border-radius: 6px;
  }
  .filters .check { display: flex; align-items: center; gap: 10px; min-height: 44px; }
  .filters .check input { width: 22px; height: 22px; margin: 0; accent-color: var(--ink); }
  .filters .count { margin: 0; font-size: 0.9375rem; }
  .filters .btn { justify-self: start; }
  .filters .btn[hidden] { display: none; }
  @media (min-width: 480px) and (max-width: 959px) {
    .filters { grid-template-columns: 1fr 1fr; column-gap: 16px; }
    .filters .count, .filters .check { grid-column: 1 / -1; }
  }

  /* The picked place: a card over the map on desktop, a panel at the bottom on phones */
  .detail { display: grid; gap: 10px; background: var(--paper); padding: 14px; }
  .detail[hidden] { display: none; }
  .detail :global(.dhead) { display: flex; align-items: flex-start; gap: 12px; }
  .detail :global(h2) { font-size: 1.0625rem; margin: 0; line-height: 1.3; flex: 1; padding-top: 8px; }
