---
import Base from '../layouts/Base.astro';
import Pair from '../components/Pair.astro';
import LicenceTag from '../components/LicenceTag.astro';
import LikelyTag from '../components/LikelyTag.astro';
import LabelKey from '../components/LabelKey.astro';
import WaterMap from '../components/WaterMap.astro';
import Src from '../components/Src.astro';
import { doorstep, summary, townsNear, water, where } from '../lib/data';
import { Count, LICENCE_SENTENCE, hectares, longDate, num, pct, tidyDistrict } from '../lib/format';

const [lead, ...villages] = doorstep(10);
const districts = summary?.top_districts.slice(0, 8) ?? [];
const districtMax = Math.max(...districts.map((d) => d.ha), 1);
const tidy = (d: string | null) => (d ? tidyDistrict(d) : null);
const haText = (ha: number) => (ha < 10 ? ha.toFixed(1) : num(ha));
// Who each plant supplies and what the news reported, each checked against the article
// (docs/sources.json claims water-plant-towns and plant-news). Only news that ties the plant to mud or mining,
// the latest relevant report first.
const PLANTS: Record<string, { supplies: string; news: { when: string; text: string; src: string; outlet: string }[] }> = {
  Daboase: { supplies: 'Sekondi-Takoradi, with the Inchaban plant', news: [
    { when: 'August 2026', text: "Mud in the Pra at Daboase reached more than 20 times the permitted level. Drone footage showed mining right opposite the plant's intake.", src: 'citi-daboase-2026', outlet: 'Citi Newsroom' },
  ] },
  Weija: { supplies: 'central and western Accra', news: [
    { when: 'May 2026', text: 'Potroase, where the Densu comes down from the Atewa hills, has become a hotspot for illegal mining. Water Resources Commission data show the river getting dirtier there and at Weija over five years.', src: 'fourth-estate-2026-water', outlet: 'The Fourth Estate' },
  ] },
  Kwanyako: { supplies: 'Winneba, Swedru and Kasoa', news: [
    { when: 'September 2025', text: 'Ghana Water said mud in the Ayensu reached more than 12 times what the plant was built to treat.', src: 'gwcl-kwanyako-news', outlet: 'GNA' },
    { when: 'May 2026', text: 'Ghana Water records show the plant was shut for 2,541 hours in 2025, more than 100 days, because of mud and silt.', src: 'fourth-estate-2026-water', outlet: 'The Fourth Estate' },
  ] },
  Barekese: { supplies: 'Greater Kumasi, with Owabi', news: [
    { when: 'April 2025', text: "Ghana Water raised prices partly over the cost of treating water hit by illegal mining. Its Ashanti manager warned that if the Offin, Barekese's main source, is not protected, Barekese will be down.", src: 'joy-barekese-2025', outlet: 'MyJoyOnline' },
  ] },
  Owabi: { supplies: 'Greater Kumasi, with Barekese', news: [] },
};
const pra = water.find((w) => w.plant === 'Daboase');
const total = summary?.total_ha ?? 0;
---
<Base description={summary ? `${num(summary.total_ha)} hectares of land cleared in 12 months ${where}. ${pct(summary.no_licence_to_mine.share)} of it has no licence to mine.` : undefined}>
  <div class="wrap">
    {summary ? (
      <section class="hero" aria-labelledby="headline">
        <h1 id="headline">
          {townsNear
            ? `At least ${num(townsNear.count)} towns and villages have land cleared within a kilometre of them.`
            : `In the last 12 months, satellites saw ${num(summary.total_ha)} hectares of land cleared ${where}.`}
        </h1>
        <p class="sub">
          Satellites saw {num(summary.total_ha)} hectares of land cleared {where} in the 12 months up to {longDate(summary.data_date)}.
        </p>
        {lead && (
          <div class="lead">
            <h2 class="who">
              <span>The town with the most cleared land around it:</span>
              <a href={`/places/${lead.place.id}`}>{lead.town.name}</a>{lead.town.district && `, ${tidy(lead.town.district)}`}
            </h2>
            <Pair place={lead.place} variant="lead" eager>
              <figcaption class="caption">
                <span>Within 1 km of {lead.town.name}, satellites saw {hectares(lead.town.ha)} cleared, in {lead.town.patches === 1 ? 'one patch' : `${lead.town.patches} patches`}. These pictures show the largest patch ({hectares(lead.place.ha)}), first seen on {longDate(lead.place.first_seen)}. {LICENCE_SENTENCE[lead.place.licence]} Each week we show the town with the most cleared land around it, so the town here can change.</span>
                <span class="hint">The ring sits on the cleared patch. Tap a picture to enlarge and zoom in.</span>
              </figcaption>
            </Pair>
          </div>
        )}
      </section>
    ) : (
      <section class="hero"><h1>The first weekly update has not run yet.</h1></section>
    )}

    {lead && (
      <section class="band doorstep" aria-labelledby="others">
        <div>
          <h2 id="others">Other towns and villages with the most cleared land around them</h2>
          <p class="intro">Each pair shows one of the largest cleared patches within 1 km of the town, before and after. The ring sits on the patch. Tap a picture to enlarge and zoom in.</p>
        </div>
        <ul class="villages">
          {villages.map(({ town, place: p }) => (
            <li>
              <h3 class="town"><a href={`/places/${p.id}`}>{town.name}</a><span>, {tidy(town.district)}</span></h3>
              <Pair place={p} variant="row">
                <figcaption class="card">
                  <span>{haText(town.ha)} ha cleared within 1 km</span>
                  <span class="tags"><LicenceTag licence={p.licence} />{p.likely_galamsey && <LikelyTag />}</span>
                </figcaption>
              </Pair>
            </li>
          ))}
        </ul>
        <LabelKey galamsey />
        <p class="note">Town and village points come from OpenStreetMap, which misses many villages, so the true count may be higher.</p>
        {summary && <div class="actions"><a class="btn primary" href="/map">See all {num(summary.patches)} places on the map</a></div>}
      </section>
    )}

    <section class="band find" aria-labelledby="find" data-find hidden>
      <h2 id="find">Find a town or village</h2>
      <p class="intro">See how much land was cleared within 1 km of it in the last 12 months.</p>
      <label class="field">
        <span class="visually-hidden">Town or village name</span>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <input type="search" placeholder="Town or village name" autocomplete="off" spellcheck="false" data-find-q />
      </label>
      <p class="status muted" aria-live="polite" data-find-status></p>
      <ul class="results" data-find-results></ul>
    </section>

    {summary && (
      <section class="band" aria-labelledby="facts">
        <h2 id="facts" class="visually-hidden">In short</h2>
        <div class="facts3">
          <p><strong>{num(summary.football_pitches)} football pitches.</strong> That is how much land {num(summary.total_ha)} hectares is.</p>
          <p><strong>{pct(summary.no_licence_to_mine.share)} of it</strong> is on land with no licence to mine, going by the Minerals Commission's register.</p>
          <p><strong>Most of the cleared land</strong> shows signs of mining in the pictures: pits, bare orange ground and muddy ponds. Small, new patches less often do. <a href="/method#mining">How we checked</a></p>
        </div>
      </section>
    )}

    {pra && pra.ha > 0 && (
      <section class="band water" aria-labelledby="mud">
        <div class="say">
          <h2 id="mud">Where the mud goes</h2>
          <p class="big">{pct(pra.ha / total)} of the cleared land, {num(pra.ha)} hectares, lies on land that drains into the River Pra above the Daboase water treatment plant. Daboase supplies Sekondi-Takoradi.</p>
          <p>When it rains, mud from cleared land and mining pits washes into the rivers, and the more mud there is, the harder and dearer the water is to treat. Clearing upstream does not tell us how much mud reaches a plant on a given day.</p>
          <h3>{Count(water.length)} water treatment plants downstream of the areas we cover</h3>
          <ul class="plants">
            {water.map((w) => (
              <li>
                <span class="p"><strong>{w.plant}</strong> on the {w.river}</span>
                <span class="v">{num(w.ha)} ha</span>
                {PLANTS[w.plant] && <span class="t">Supplies {PLANTS[w.plant].supplies}</span>}
                {PLANTS[w.plant]?.news.map((n) => (
                  <span class="n"><span class="when">{n.when}</span> {n.text} <Src id={n.src}>{n.outlet}</Src></span>
                ))}
              </li>
            ))}
          </ul>
          <p class="muted small">Hectares cleared in the last 12 months on the land that drains to each plant. Smaller water works on these rivers are not listed.</p>
        </div>
        <div class="look"><WaterMap praHa={pra.ha} /></div>
      </section>
    )}

    {districts.length > 0 && (
      <section class="band" aria-labelledby="where">
        <h2 id="where">Which districts</h2>
        <p class="intro">Hectares cleared in the last 12 months, by district. Pick one to see its places on the map.</p>
        <table class="districts">
          <thead><tr><th scope="col">District</th><th scope="col">Hectares</th></tr></thead>
          <tbody>
            {districts.map((d) => (
              <tr>
                <th scope="row"><a href={`/map?district=${encodeURIComponent(d.district)}`}>{tidy(d.district)}</a></th>
                <td><span class="bar" style={`width:${(d.ha / districtMax) * 100}%`}></span><span class="v">{num(d.ha)}</span></td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="actions"><a class="btn primary" href="/map">See every place on the map</a></div>
      </section>
    )}

    {summary && (
      <section class="band" aria-labelledby="licences">
        <h2 id="licences">What licence is on the land</h2>
        <p class="intro">We check every patch against the Minerals Commission's register of active licences. The register also says who holds each licence. We leave the names out, because a licence on the land does not show who cleared it.</p>
        <ul class="licences">
          {(['no licence', 'prospecting only', 'small-scale licence', 'large-scale lease'] as const).map((l) => (
            <li><LicenceTag licence={l} /><span class="v">{num(summary.by_licence[l].ha)} ha</span><span class="muted">{pct(summary.by_licence[l].share)}</span></li>
          ))}
        </ul>
        <p class="muted small measure">A prospecting licence lets a company explore for gold. It does not allow mining. Clearing inside a small-scale licence or a large-scale lease may be licensed mining.</p>
      </section>
    )}
  </div>
</Base>

<script>
  const box = document.querySelector<HTMLElement>('[data-find]');
  if (box) {
    type Row = [string, string | null, number, number, string[], number, number];
    const q = box.querySelector<HTMLInputElement>('[data-find-q]')!;
    const status = box.querySelector<HTMLElement>('[data-find-status]')!;
    const results = box.querySelector<HTMLUListElement>('[data-find-results]')!;
    const fmt = new Intl.NumberFormat('en-GB', { maximumFractionDigits: 1 });
    const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().replace(/[^a-z0-9]/g, '');
    let rows: Promise<Row[]> | null = null;
    const load = () => (rows ??= fetch('/towns.json').then((r) => r.json()));
    box.hidden = false;
    q.addEventListener('focus', load, { once: true });

    async function search() {
      const term = fold(q.value);
      if (term.length < 2) { results.replaceChildren(); status.textContent = ''; return; }
      const all = await load();
      if (fold(q.value) !== term) return;
      // The exact name first, then names that start with what was typed, then names that contain it, each by land cleared
      const rank = (name: string) => { const f = fold(name); return f === term ? 0 : f.startsWith(term) ? 1 : f.includes(term) ? 2 : 3; };
      const found = all.map((r) => ({ r, rank: rank(r[0]) })).filter((m) => m.rank < 3)
        .sort((a, b) => a.rank - b.rank || b.r[2] - a.r[2]).slice(0, 8);
      status.textContent = found.length
        ? ''
        : 'No cleared land found within 1 km of a place with that name. It may be outside the areas we cover so far, or missing from OpenStreetMap.';
      results.replaceChildren(...found.map(({ r: [name, dist, ha, n] }) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = `/map?town=${encodeURIComponent(dist ? `${name} (${dist})` : name)}`;
        const b = document.createElement('strong');
        b.textContent = name;
        a.append(b, dist ? `, ${dist}` : '');
        const s = document.createElement('span');
        s.textContent = `${fmt.format(ha)} ha cleared within 1 km, in ${n} ${n === 1 ? 'patch' : 'patches'}. Opens them on the map.`;
        li.append(a, s);
        return li;
      }));
    }
    q.addEventListener('input', search);
  }
</script>

<style>
  .hero { display: grid; gap: 16px; padding: 28px 0 28px; }
  .hero .lead { margin-top: 8px; }
  @media (min-width: 1100px) {
    .hero { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); grid-template-rows: auto 1fr; column-gap: 48px; padding-top: 48px; }
    .hero h1, .sub { grid-column: 1; }
    .hero .lead { grid-column: 2; grid-row: 1 / span 2; margin-top: 0; }
  }
  .hero h1 { font-size: clamp(1.875rem, 4.6vw, 3.5rem); line-height: 1.05; letter-spacing: -0.025em; margin: 0; font-weight: 800; max-width: 21ch; }
  .sub { font-size: 1.1875rem; line-height: 1.45; margin: 0; max-width: 46ch; }

  .doorstep { display: grid; gap: 20px; }
  .doorstep .intro { margin-bottom: 0; }
  .doorstep .actions { margin-top: 4px; }
  .who { font-size: 1.25rem; font-weight: 800; line-height: 1.25; margin: 0 0 12px; }
  .who span { font-weight: 400; }
  .caption { display: grid; gap: 4px; margin-top: 10px; max-width: 60ch; }
  .caption .hint { color: var(--muted); font-size: 0.9375rem; }
  /* Each place is a pair: tight inside (4 px), wide apart (28 to 40 px), so pairs never run into each other */
  .villages { list-style: none; margin: 0; padding: 0; display: grid; gap: 36px; grid-template-columns: minmax(0, 1fr); }
  .card { display: grid; gap: 2px; margin-top: 10px; font-size: 0.9375rem; line-height: 1.35; }
  .town { font-size: 1.125rem; line-height: 1.3; margin: 0 0 10px; }
  .town span { font-weight: 400; color: var(--muted); }
  .card .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .card :global(.tag) { white-space: normal; }
  .note { margin: 0; font-size: 0.9375rem; color: var(--muted); max-width: 70ch; }
  @media (max-width: 719px) {
    .lead .caption { padding: 0 var(--gutter); }
  }
  @media (min-width: 720px) { .villages { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px 28px; } }
  @media (min-width: 1100px) { .villages { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .field { display: flex; align-items: center; gap: 10px; max-width: 520px; border: 2px solid var(--ink); border-radius: 6px; padding: 0 12px; background: var(--paper); }
  .field:focus-within { outline: 3px solid var(--focus); outline-offset: 2px; }
  .field input { flex: 1; min-width: 0; min-height: 52px; border: 0; background: transparent; color: var(--ink); font: inherit; font-size: 1.125rem; outline: none; }
  .find .status { margin: 10px 0 0; max-width: 60ch; }
  .find .status:empty { display: none; }
  .results { list-style: none; margin: 8px 0 0; padding: 0; max-width: 640px; }
  /* The rows are made by the search script, so scoped styles need :global to reach them */
  .results :global(li) { display: grid; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .results :global(a) { font-size: 1.0625rem; }
  .results :global(span) { color: var(--muted); font-size: 0.9375rem; }

  .facts3 { display: grid; gap: 20px; }
  .facts3 p { margin: 0; max-width: 36ch; font-size: 1.0625rem; }
  .facts3 strong { display: block; font-size: 1.5rem; line-height: 1.2; letter-spacing: -0.01em; margin-bottom: 4px; }
  @media (min-width: 720px) { .facts3 { grid-template-columns: repeat(3, 1fr); gap: 32px; } }

  .water { display: grid; gap: 28px; }
  .water .big { font-size: 1.25rem; line-height: 1.45; font-weight: 700; max-width: 40ch; }
  .water p { max-width: 58ch; }
  .water h3 { font-size: 1.0625rem; margin: 24px 0 4px; }
  .plants { list-style: none; padding: 0; margin: 0 0 12px; max-width: 560px; }
  .plants li { display: grid; grid-template-columns: 1fr auto; gap: 2px 16px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .plants .v { font-weight: 700; text-align: right; }
  .plants .t { grid-column: 1 / -1; color: var(--muted); font-size: 0.9375rem; }
  .plants .n { grid-column: 1 / -1; font-size: 0.9375rem; line-height: 1.45; margin-top: 4px; }
  .plants .when { font-weight: 700; }
  @media (min-width: 1000px) { .water { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); column-gap: 48px; align-items: start; } .water .look { position: sticky; top: 16px; } }

  .districts { border-collapse: collapse; width: 100%; max-width: 720px; margin-bottom: 24px; }
  .districts th, .districts td { padding: 8px 0; border-bottom: 1px solid var(--line); text-align: left; font-weight: 400; }
  .districts thead th { font-weight: 700; font-size: 0.9375rem; }
  .districts tbody th { width: 45%; padding-right: 16px; }
  .districts td { display: flex; align-items: center; gap: 10px; }
  .districts .bar { display: block; height: 16px; background: var(--ink); border-radius: 0 4px 4px 0; min-width: 2px; max-width: calc(100% - 56px); }
  .districts .v { font-weight: 700; }

  .licences { list-style: none; margin: 0 0 16px; padding: 0; max-width: 560px; }
  .licences li { display: grid; grid-template-columns: 1fr auto 3.5rem; gap: 12px; align-items: center; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .licences li > :global(.tag) { justify-self: start; }
  .licences .v { font-weight: 700; text-align: right; }
  .licences .muted { text-align: right; }
</style>
