---
// This week's posts, ready to save and copy on a phone. Not linked from the site, not in the sitemap, not indexed.
import Base from '../../layouts/Base.astro';
import { sharePosts } from '../../lib/share';
import { summary } from '../../lib/data';
import { longDate } from '../../lib/format';
---
<Base title="Posts for this week" description="Ready-to-post images and words for this week.">
  <meta slot="head" name="robots" content="noindex, nofollow">
  <div class="wrap">
    <h1>Posts for this week</h1>
    <p class="measure">{summary && <>Made from the satellite data up to {longDate(summary.data_date)}. </>}Save the image, copy the words, post it. Put the link in your first reply, not in the post.</p>
    <ol class="posts">
      {sharePosts.map((p) => (
        <li>
          <h2>{p.title}</h2>
          <a href={`/share/${p.slug}.jpg`} class="pic"><img src={`/share/${p.slug}.jpg`} alt={p.alt} width="1080" height="1350" loading="lazy" decoding="async" /></a>
          <p><a class="btn" href={`/share/${p.slug}.jpg`} download={`galamsey-${p.slug}.jpg`}>Save the image</a></p>
          {[['Post', p.text], ['Image description (alt text)', p.alt], ['First reply', p.reply]].map(([label, value]) => (
            <div class="copy">
              <div class="head"><h3>{label}</h3><button type="button" class="btn small" data-copy>Copy</button></div>
              <p data-text>{value}</p>
            </div>
          ))}
        </li>
      ))}
    </ol>
  </div>
</Base>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
    b.addEventListener('click', async () => {
      const text = b.closest('.copy')!.querySelector<HTMLElement>('[data-text]')!.innerText;
      try { await navigator.clipboard.writeText(text); b.textContent = 'Copied'; } catch { b.textContent = 'Select and copy'; }
      setTimeout(() => (b.textContent = 'Copy'), 2000);
    });
  }
</script>

<style>
  h1 { margin: 32px 0 8px; }
  .posts { list-style: none; padding: 0; margin: 24px 0 64px; display: grid; gap: 56px; }
  .posts > li { border-top: 1px solid var(--line); padding-top: 24px; max-width: 560px; }
  h2 { margin: 0 0 12px; }
  .pic img { display: block; width: 100%; height: auto; border: 1px solid var(--line); }
  .copy { margin-top: 16px; }
  .head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  h3 { margin: 0; font-size: 1rem; }
  [data-text] { white-space: pre-line; margin: 6px 0 0; padding: 12px; border: 1px solid var(--line); background: var(--paper); }
  .btn.small { min-height: 44px; padding: 0 16px; }
</style>
