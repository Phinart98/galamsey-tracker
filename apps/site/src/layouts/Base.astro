---
import '../styles/global.css';
import fontUrl from '@fontsource-variable/atkinson-hyperlegible-next/files/atkinson-hyperlegible-next-latin-wght-normal.woff2?url';
import Viewer from '../components/Viewer.astro';
import Src from '../components/Src.astro';
import { lastSuccess, pictureYears, summary, STALE_DAYS } from '../lib/data';
import { longDate } from '../lib/format';
import { CONTACT_EMAIL, WEEKLY } from '../lib/site';

interface Props { title?: string; description?: string; image?: string }
const {
  title,
  description = 'Satellite evidence of land cleared for gold mining in Ghana, from NASA and Copernicus data.',
  image = '/og/home.jpg',
} = Astro.props;
const fullTitle = title ? `${title} | Galamsey Tracker` : 'Galamsey Tracker';
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Home' },
  { href: '/map', label: 'Map' },
  { href: '/method', label: 'How it works' },
  { href: '/data', label: 'Data' },
  { href: '/about', label: 'About' },
];
const staleAtBuild = WEEKLY && (lastSuccess ? Date.now() - Date.parse(lastSuccess) > STALE_DAYS * 864e5 : true);
---
<!doctype html>
<html lang="en-GH">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <meta property="og:title" content={title ?? 'Galamsey Tracker'}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:type" content="website">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="color-scheme" content="light dark">
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <!-- Without this the headline re-wraps when the font arrives and pushes the lead pictures down -->
  <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin>
  <script is:inline>
    try { const t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch {}
  </script>
  <slot name="head" />
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head">
    <div class="wrap row">
      <a class="brand" href="/">Galamsey Tracker</a>
      <div class="tools">
        <nav class="wide" aria-label="Main">
          {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
        </nav>
        <button class="icon theme" type="button" data-theme-toggle aria-label="Switch to dark mode">
          <svg class="moon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
          <svg class="sun" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>
        <button class="icon menu-open" type="button" data-menu-open aria-haspopup="dialog" hidden>
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span>Menu</span>
        </button>
      </div>
    </div>
  </header>
  <dialog class="sheet-nav" data-menu aria-label="Menu">
    <div class="wrap row">
      <a class="brand" href="/">Galamsey Tracker</a>
      <button class="icon" type="button" data-menu-close>
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span>Close</span>
      </button>
    </div>
    <nav class="wrap" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
    </nav>
  </dialog>

  <div class="stale" data-stale data-last={lastSuccess ?? ''} hidden={!staleAtBuild}>
    <p class="wrap">
      {lastSuccess
        ? <>Data last updated {longDate(lastSuccess.slice(0, 10))}. The weekly update is late, so recent changes may be missing.</>
        : <>The weekly update has not run yet.</>}
    </p>
  </div>

  <main id="main"><slot /></main>

  <footer class="site-foot">
    <div class="wrap">
      <p>
        {summary && <>Data up to {longDate(summary.data_date)}. {WEEKLY ? 'Updated every Monday. ' : 'This is a preview and is not updated yet. '}</>}
        Built from <Src id="opera-dist-alert">NASA OPERA land disturbance data</Src> and <Src id="sentinel2">Copernicus Sentinel-2</Src> images. Contains modified Copernicus Sentinel data {pictureYears}. Licence labels from the <Src id="minerals-commission-cadastre">Minerals Commission's public register</Src>.
      </p>
      <nav class="foot-nav" aria-label="Footer">
        {nav.map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <p><a href="/data">Download the data</a>.{CONTACT_EMAIL && <> Contact: <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.</>}</p>
    </div>
  </footer>
  <Viewer />

  <script is:inline define:vars={{ staleDays: STALE_DAYS, weekly: WEEKLY }}>
    const root = document.documentElement;
    const dark = () => root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
    const label = () => document.querySelectorAll('[data-theme-toggle]').forEach((b) => { b.setAttribute('aria-label', dark() ? 'Switch to light mode' : 'Switch to dark mode'); });
    label();
    document.querySelectorAll('[data-theme-toggle]').forEach((b) => b.addEventListener('click', () => {
      root.dataset.theme = dark() ? 'light' : 'dark';
      try { localStorage.setItem('theme', root.dataset.theme); } catch {}
      label();
      dispatchEvent(new CustomEvent('themechange', { detail: root.dataset.theme }));
    }));
    const menu = document.querySelector('[data-menu]');
    const menuOpen = document.querySelector('[data-menu-open]');
    if (menu.showModal) {
      menuOpen.hidden = false;
      menuOpen.addEventListener('click', () => menu.showModal());
      menu.querySelector('[data-menu-close]').addEventListener('click', () => menu.close());
      menu.addEventListener('click', (e) => { if (e.target.closest('a')) menu.close(); });
      matchMedia('(min-width: 721px)').addEventListener('change', (e) => { if (e.matches) menu.close(); });
    }
    const stale = document.querySelector('[data-stale]');
    const last = Date.parse(stale.dataset.last);
    if (weekly && (!last || Date.now() - last > staleDays * 864e5)) stale.hidden = false;
  </script>
</body>
</html>

<style>
  .skip { position: absolute; left: -9999px; }
  .skip:focus { left: 16px; top: 8px; z-index: 10; background: var(--paper); padding: 8px 12px; }
  .site-head { border-bottom: 1px solid var(--line); }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; }
  .brand { font-weight: 800; font-size: 1.125rem; text-decoration: none; letter-spacing: -0.01em; padding: 10px 0; }
  .tools { display: flex; align-items: center; gap: 8px; }
  .wide { display: flex; align-items: center; gap: 20px; margin-right: 12px; }
  .wide a { text-decoration: none; white-space: nowrap; padding: 10px 0; }
  .wide a:hover, .wide a[aria-current='page'] { text-decoration: underline; }
  .icon {
    font: inherit; font-weight: 700; color: var(--ink); background: transparent; cursor: pointer;
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-width: 44px; min-height: 44px; padding: 0 10px; border: 1px solid var(--line); border-radius: 6px;
  }
  .icon:hover { border-color: var(--ink); }
  .icon svg { flex: none; }
  .icon[hidden] { display: none; }
  .theme { padding: 0; }
  .theme .sun { display: none; }
  :global(:root[data-theme='dark']) .theme .sun { display: block; }
  :global(:root[data-theme='dark']) .theme .moon { display: none; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .theme .sun { display: block; }
    :global(:root:not([data-theme='light'])) .theme .moon { display: none; }
  }
  @media (min-width: 721px) { .menu-open { display: none !important; } }
  @media (max-width: 720px) { .wide { display: none; } }

  /* The phone menu covers the whole page, so it reads as a place to go rather than a dropdown */
  .sheet-nav {
    width: 100vw; height: 100dvh; max-width: 100vw; max-height: 100dvh; margin: 0; padding: 0; border: 0;
    background: var(--paper); color: var(--ink);
    opacity: 1; transition: opacity 200ms cubic-bezier(0.4, 0, 1, 1), overlay 200ms allow-discrete, display 200ms allow-discrete;
  }
  .sheet-nav:not([open]) { opacity: 0; }
  .sheet-nav[open] { transition-duration: 250ms; transition-timing-function: cubic-bezier(0.2, 0, 0, 1); }
  @starting-style { .sheet-nav[open] { opacity: 0; } }
  .sheet-nav .row { border-bottom: 1px solid var(--line); }
  .sheet-nav nav { display: flex; flex-direction: column; padding-top: 8px; padding-bottom: 32px; }
  .sheet-nav nav a {
    font-size: 1.75rem; font-weight: 800; letter-spacing: -0.01em; text-decoration: none;
    padding: 14px 0; border-bottom: 1px solid var(--line);
  }
  .sheet-nav nav a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 3px; }
  .foot-nav { display: flex; flex-wrap: wrap; gap: 4px 20px; margin-bottom: 8px; }
  .foot-nav a { color: var(--ink); padding: 8px 0; }
  .site-head { position: relative; }
  .stale { background: var(--signal); color: var(--signal-ink); font-weight: 700; }
  .stale p { margin: 0; padding-top: 10px; padding-bottom: 10px; }
  .site-foot { border-top: 1px solid var(--line); margin-top: 48px; padding: 24px 0 40px; font-size: 0.9375rem; color: var(--muted); }
  .site-foot p { max-width: 70ch; margin: 0 0 8px; }
</style>
