---
// Three bars, one per year, for the same 12-month window. One series, so no legend: each bar is labelled.
import type { TrendPoint } from '../lib/data';
import { longDate, num } from '../lib/format';

interface Props { points: TrendPoint[] }
const { points } = Astro.props;
const max = Math.max(...points.map((p) => p.total_ha), 1);
---
<table class="years">
  <caption class="visually-hidden">Hectares cleared in the 12 months up to the same day, one year apart</caption>
  <thead class="visually-hidden"><tr><th scope="col">12 months up to</th><th scope="col">Hectares cleared</th></tr></thead>
  <tbody>
    {points.map((p) => (
      <tr>
        <th scope="row">12 months up to {longDate(p.date)}</th>
        <td><span class="track"><span class="bar" style={`width:${(p.total_ha / max) * 100}%`}></span></span><span class="v">{num(p.total_ha)} ha</span></td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .years { border-collapse: collapse; width: 100%; max-width: 720px; margin: 0 0 16px; }
  .years th, .years td { padding: 10px 0; text-align: left; font-weight: 400; border-bottom: 1px solid var(--line); }
  .years tbody th { display: block; padding-bottom: 6px; border-bottom: 0; }
  .years td { display: flex; align-items: center; gap: 10px; padding-top: 0; }
  /* The bar sits in a track that fills the row, so its width is a true share of the largest year */
  .track { flex: 1; min-width: 0; }
  .bar { display: block; height: 22px; background: var(--ink); border-radius: 0 4px 4px 0; min-width: 2px; }
  .v { font-weight: 700; white-space: nowrap; min-width: 6.5em; text-align: right; }
</style>
