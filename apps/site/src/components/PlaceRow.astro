---
import Pair from './Pair.astro';
import LicenceTag from './LicenceTag.astro';
import LikelyTag from './LikelyTag.astro';
import { hasPair, type Place } from '../lib/data';
import { NO_PICTURE, hectares, longDate, noPicture, placeName } from '../lib/format';

interface Props { place: Place }
const { place } = Astro.props;
---
<li class="place">
  {hasPair(place)
    ? <Pair place={place} variant="row" />
    : <p class="nopair muted small">{NO_PICTURE[noPicture(place)]}</p>}
  <div class="text">
    <h3><a href={`/places/${place.id}`}>{hectares(place.ha)} cleared {placeName(place)}</a></h3>
    <p class="muted small">First seen {longDate(place.first_seen)}.</p>
  </div>
  <div class="lic"><LicenceTag licence={place.licence} /><LikelyTag hidden={!place.likely_galamsey} /></div>
</li>

<style>
  .place { display: grid; gap: 10px; padding: 20px 0; border-bottom: 1px solid var(--line); }
  @container (min-width: 620px) {
    .place { grid-template-columns: 264px 1fr auto; gap: 24px; align-items: center; padding: 16px 0; }
  }
  h3 { margin: 0 0 2px; font-size: 1.0625rem; line-height: 1.35; }
  h3 a { text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  p { margin: 0; }
  .lic { display: flex; flex-wrap: wrap; gap: 6px; align-items: flex-start; }
  @container (min-width: 620px) { .lic { flex-direction: column; align-items: flex-end; } }
  .nopair { aspect-ratio: 2 / 1; display: grid; place-items: center; padding: 16px; text-align: center; background: var(--paper-2); }
</style>
