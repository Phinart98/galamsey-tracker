---
// One picture at a time with arrows to slide between before and after. Swiping works too, because the two
// pictures sit in a scroll-snap track. Each picture is still a [data-open] link, so a tap opens the viewer.
import type { Chip } from '../lib/data';
import { longDate, shortDate, srcsets } from '../lib/format';

interface Props {
  chips: { before: Chip; after: Chip };
  where: string;
  sizes: string;
}
const { chips, where, sizes } = Astro.props;
const slides = (['before', 'after'] as const).map((side) => ({
  side,
  word: side === 'before' ? 'Before' : 'After',
  date: chips[side].date,
  s: srcsets(chips[side]),
}));
---
<div class="flip" data-flip>
  <div class="track" data-flip-track>
    {slides.map(({ side, word, date, s }) => (
      <a class="slide" href={s.large} data-open={side}>
        <img src={s.src} srcset={s.webp} sizes={sizes} width="360" height="360" loading="lazy" decoding="async"
             alt={`Satellite image ${side === 'before' ? 'from before the clearing' : 'after the clearing'}, ${longDate(date)}, of the largest cleared patch ${where}`} />
        <span class="when"><strong>{word}</strong> <span>Taken {shortDate(date)}</span></span>
      </a>
    ))}
  </div>
  <button class="arrow prev" type="button" data-flip-to="0" aria-label="Show before" hidden>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
  <button class="arrow next" type="button" data-flip-to="1" aria-label="Show after" hidden>
    <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<script>
  {
    const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ease = (t: number) => 1 - Math.pow(1 - t, 3);
    document.querySelectorAll<HTMLElement>('[data-flip]').forEach((box) => {
      const track = box.querySelector<HTMLElement>('[data-flip-track]')!;
      const arrows = [...box.querySelectorAll<HTMLButtonElement>('[data-flip-to]')];
      const at = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));
      const sync = () => {
        const i = at();
        const off = arrows.find((b) => Number(b.dataset.flipTo) === i)!;
        const on = arrows.find((b) => b !== off)!;
        on.disabled = false;
        // Keep keyboard focus on the slider when the pressed arrow switches off
        if (document.activeElement === off) on.focus();
        off.disabled = true;
      };
      // Our own 300 ms slide: browsers pick their own smooth-scroll speed, and snapping would cut it short
      const go = (i: number) => {
        const from = track.scrollLeft, to = i * track.clientWidth;
        if (still() || from === to) { track.scrollLeft = to; sync(); return; }
        track.style.scrollSnapType = 'none';
        const t0 = performance.now();
        const step = (now: number) => {
          const t = Math.min((now - t0) / 300, 1);
          track.scrollLeft = from + (to - from) * ease(t);
          if (t < 1) requestAnimationFrame(step);
          else { track.style.scrollSnapType = ''; sync(); }
        };
        requestAnimationFrame(step);
      };
      arrows.forEach((b) => { b.hidden = false; b.addEventListener('click', () => go(Number(b.dataset.flipTo))); });
      let queued = false;
      track.addEventListener('scroll', () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => { queued = false; sync(); });
      }, { passive: true });
      // Show the recent picture first
      track.scrollLeft = track.clientWidth;
      sync();
    });
  }
</script>

<style>
  .flip { position: relative; }
  .track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; scrollbar-width: none; background: var(--paper-2); }
  .track::-webkit-scrollbar { display: none; }
  .slide { position: relative; flex: 0 0 100%; scroll-snap-align: start; aspect-ratio: 1; display: block; text-decoration: none; color: var(--ink); }
  .slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .when { position: absolute; left: 6px; bottom: 6px; padding: 2px 8px; border-radius: 4px; background: var(--paper); font-size: 0.8125rem; line-height: 1.35; }
  .when strong { display: block; font-weight: 800; }
  .slide:hover .when { text-decoration: underline; }
  .slide:focus-visible { outline: 3px solid var(--focus); outline-offset: -3px; }
  .arrow {
    position: absolute; top: 50%; translate: 0 -50%; width: 44px; height: 44px; display: grid; place-items: center;
    border: 2px solid var(--ink); border-radius: 50%; background: var(--paper); color: var(--ink); cursor: pointer; padding: 0;
    transition: opacity 150ms ease-out;
  }
  .prev { left: 6px; }
  .next { right: 6px; }
  .arrow:disabled { opacity: 0; pointer-events: none; }
  .arrow:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  @media (hover: hover) { .arrow:hover { background: var(--ink); color: var(--paper); } }
  @media (prefers-reduced-motion: reduce) { .arrow { transition: none; } }
</style>
