---
---
<dialog class="viewer" aria-labelledby="viewer-title" data-viewer>
  <div class="bar">
    <h2 id="viewer-title" data-v-title></h2>
    <a class="more" data-v-link href="/">Open this place</a>
    <button class="close" type="button" data-v-close>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      Close
    </button>
  </div>
  <div class="stages" data-v-stages>
    <figure class="stage" data-v-stage="before">
      <div class="zoom"><img data-v-img="before" alt="" width="720" height="720" draggable="false"></div>
      <span class="ghost" aria-hidden="true" hidden></span>
      <figcaption class="stamp"><strong>Before</strong> <span data-v-date="before"></span></figcaption>
    </figure>
    <figure class="stage" data-v-stage="after">
      <div class="zoom"><img data-v-img="after" alt="" width="720" height="720" draggable="false"></div>
      <span class="ghost" aria-hidden="true" hidden></span>
      <figcaption class="stamp"><strong>After</strong> <span data-v-date="after"></span></figcaption>
    </figure>
  </div>
  <div class="controls">
    <div class="switch" role="group" aria-label="Which picture to show" data-v-switch>
      <button type="button" data-v-show="before" aria-pressed="false">Before</button>
      <button type="button" data-v-show="after" aria-pressed="true">After</button>
    </div>
    <div class="zbtns" role="group" aria-label="Zoom">
      <button type="button" data-v-zoom-by="0.625" aria-label="Zoom out" disabled>&minus;</button>
      <button type="button" data-v-zoom-by="1.6" aria-label="Zoom in">+</button>
      <button type="button" class="fit" data-v-fit disabled>Fit</button>
    </div>
    <a class="more narrow" data-v-link href="/">Open this place</a>
    <p class="hint muted small" data-v-hint></p>
  </div>
</dialog>

<script is:inline>
  (() => {
    const d = document.querySelector('[data-viewer]');
    if (!d || !d.showModal) return;
    const q = (s) => d.querySelector(s);
    const stages = q('[data-v-stages]');
    const stageOf = { before: q('[data-v-stage=before]'), after: q('[data-v-stage=after]') };
    const layers = [...d.querySelectorAll('.zoom')];
    const coarse = matchMedia('(pointer: coarse)').matches;
    const still = () => matchMedia('(prefers-reduced-motion: reduce)').matches;
    let side = 'after';
    let opener = null;

    // Wide screens show both pictures side by side; narrow ones show one and switch
    const both = () => stages.dataset.both === 'true';
    const layout = () => {
      const r = stages.getBoundingClientRect();
      stages.dataset.both = String(r.width >= 640 && r.width / Math.max(r.height, 1) >= 1.45);
      q('[data-v-switch]').hidden = both();
      q('[data-v-hint]').textContent = coarse
        ? (both() ? 'Pinch or double-tap to zoom. Both pictures zoom together.' : 'Pinch or double-tap to zoom. Swipe to switch between before and after.')
        : `Scroll, double-click or use + and − to zoom. Drag to look around.${both() ? ' Both pictures move together, and a ring marks the same spot on the other one.' : ' Arrow keys switch between before and after.'}`;
      render(false);
    };
    new ResizeObserver(layout).observe(stages);

    const show = (next) => {
      side = next;
      d.querySelectorAll('[data-v-show]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.vShow === side)));
      stageOf.before.classList.toggle('on', side === 'before');
      stageOf.after.classList.toggle('on', side === 'after');
    };

    const open = (fig, start) => {
      q('[data-v-title]').textContent = fig.dataset.title;
      d.querySelectorAll('[data-v-link]').forEach((a) => { a.href = fig.dataset.href; });
      for (const s of ['before', 'after']) {
        const img = q(`[data-v-img=${s}]`);
        img.src = fig.dataset[s];
        img.alt = `Satellite image, ${s}, ${fig.dataset[s + 'Date']}`;
        q(`[data-v-date=${s}]`).textContent = fig.dataset[s + 'Date'];
      }
      show(start);
      d.showModal();
      reset();
      layout();
      history.pushState({ viewer: true }, '');
    };

    // The phone back button closes the viewer instead of leaving the page
    const close = () => { if (history.state?.viewer) history.back(); else d.close(); };
    addEventListener('popstate', () => { if (d.open) d.close(); });
    // Safari does not focus a tapped link, so the dialog would otherwise return focus to the page top
    d.addEventListener('close', () => opener?.focus());

    document.addEventListener('click', (e) => {
      const a = e.target.closest('[data-pair] [data-open]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return;
      e.preventDefault();
      opener = a;
      open(a.closest('[data-pair]'), a.dataset.open);
    });
    q('[data-v-close]').addEventListener('click', close);
    d.addEventListener('cancel', (e) => { e.preventDefault(); close(); });
    d.querySelectorAll('[data-v-show]').forEach((b) => b.addEventListener('click', () => show(b.dataset.vShow)));

    // Zoom and pan are shared by both pictures, so the same spot stays in view.
    // Sentinel-2 pixels are 10 m, so past 3x the picture only gets blurrier.
    const MAX = 3;
    let z = 1, tx = 0, ty = 0;
    const box = () => (both() || side === 'before' ? stageOf.before : stageOf.after).getBoundingClientRect();

    function render(ease) {
      const { width: w, height: h } = box();
      tx = Math.min(0, Math.max(w * (1 - z), tx));
      ty = Math.min(0, Math.max(h * (1 - z), ty));
      for (const l of layers) {
        l.style.transition = ease && !still() ? 'transform 200ms cubic-bezier(0.2, 0, 0, 1)' : 'none';
        l.style.transform = `translate(${tx}px, ${ty}px) scale(${z})`;
      }
      stages.classList.toggle('zoomed', z > 1.01);
      q('[data-v-zoom-by="1.6"]').disabled = z >= MAX - 0.01;
      q('[data-v-zoom-by="0.625"]').disabled = z <= 1.01;
      q('[data-v-fit]').disabled = z <= 1.01;
    }
    const zoomAt = (x, y, next, ease) => {
      next = Math.min(MAX, Math.max(1, next));
      tx = x - ((x - tx) * next) / z;
      ty = y - ((y - ty) * next) / z;
      z = next;
      render(ease);
    };
    function reset(ease) { z = 1; tx = 0; ty = 0; render(ease); }
    const local = (e, stage) => {
      const r = stage.getBoundingClientRect();
      return { x: e.clientX - r.left, y: e.clientY - r.top };
    };
    const middle = () => { const { width, height } = box(); return [width / 2, height / 2]; };

    const pts = new Map();
    let start = null, pinch = null, pinched = false, lastTap = null;
    const spread = () => {
      const [a, b] = [...pts.values()];
      return { d: Math.hypot(a.x - b.x, a.y - b.y), x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
    };
    const grab = (p) => { start = { x: p.x, y: p.y, tx, ty }; };

    for (const stage of Object.values(stageOf)) {
      stage.addEventListener('pointerdown', (e) => {
        stage.setPointerCapture(e.pointerId);
        pts.set(e.pointerId, local(e, stage));
        if (pts.size === 1) grab(local(e, stage));
        if (pts.size === 2) { pinch = { ...spread(), z }; pinched = true; }
      });
      const other = stage === stageOf.before ? stageOf.after : stageOf.before;
      const ghost = other.querySelector('.ghost');
      stage.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'mouse' && both()) {
          const p = local(e, stage);
          ghost.hidden = false;
          ghost.style.translate = `${p.x}px ${p.y}px`;
        }
        if (!pts.has(e.pointerId)) return;
        pts.set(e.pointerId, local(e, stage));
        if (pts.size === 2 && pinch) {
          const now = spread();
          tx += now.x - pinch.x;
          ty += now.y - pinch.y;
          zoomAt(now.x, now.y, (pinch.z * now.d) / pinch.d, false);
          pinch.x = now.x; pinch.y = now.y;
        } else if (pts.size === 1 && start && z > 1.01) {
          const p = local(e, stage);
          tx = start.tx + p.x - start.x;
          ty = start.ty + p.y - start.y;
          render(false);
        }
      });
      const lift = (e) => {
        if (!pts.has(e.pointerId)) return;
        const p = local(e, stage);
        pts.delete(e.pointerId);
        if (pts.size === 1) { pinch = null; grab([...pts.values()][0]); return; }
        if (pts.size > 0 || !start) return;
        const dx = p.x - start.x, dy = p.y - start.y;
        const tap = Math.hypot(dx, dy) < 10 && !pinched;
        if (!pinched && !both() && z <= 1.01 && Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy)) {
          show(side === 'before' ? 'after' : 'before');
        } else if (tap && lastTap && e.timeStamp - lastTap.t < 320 && Math.hypot(p.x - lastTap.x, p.y - lastTap.y) < 30) {
          if (z > 1.01) reset(true); else zoomAt(p.x, p.y, 2.5, true);
          lastTap = null;
        } else if (tap) {
          lastTap = { ...p, t: e.timeStamp };
        }
        start = null; pinched = false;
      };
      stage.addEventListener('pointerleave', () => { ghost.hidden = true; });
      stage.addEventListener('pointerup', lift);
      stage.addEventListener('pointercancel', lift);
      stage.addEventListener('wheel', (e) => {
        e.preventDefault();
        const p = local(e, stage);
        zoomAt(p.x, p.y, z * Math.exp(-e.deltaY * 0.002), false);
      }, { passive: false });
    }

    d.querySelectorAll('[data-v-zoom-by]').forEach((b) => b.addEventListener('click', () => {
      zoomAt(...middle(), z * Number(b.dataset.vZoomBy), true);
    }));
    q('[data-v-fit]').addEventListener('click', () => reset(true));
    d.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' && !both()) show('before');
      if (e.key === 'ArrowRight' && !both()) show('after');
      if (e.key === '+' || e.key === '=') zoomAt(...middle(), z * 1.6, true);
      if (e.key === '-') zoomAt(...middle(), z / 1.6, true);
      if (e.key === '0') reset(true);
    });
    d.addEventListener('close', () => reset(false));
  })();
</script>

<style>
  /* Fills the screen on every device, so the pictures get all the room there is and nothing scrolls */
  .viewer {
    width: 100vw; height: 100dvh; max-width: 100vw; max-height: 100dvh; margin: 0; padding: 0;
    border: 0; background: var(--paper); color: var(--ink); overflow: hidden;
    opacity: 1;
    transition: opacity 200ms cubic-bezier(0.4, 0, 1, 1), overlay 200ms allow-discrete, display 200ms allow-discrete;
  }
  .viewer[open] { display: grid; grid-template-rows: auto minmax(0, 1fr) auto; transition-duration: 250ms; transition-timing-function: cubic-bezier(0.2, 0, 0, 1); }
  .viewer:not([open]) { opacity: 0; }
  @starting-style { .viewer[open] { opacity: 0; } }
  .viewer::backdrop { background: rgb(0 0 0 / 0.8); }

  .bar { display: flex; align-items: center; gap: 16px; padding: 8px var(--gutter); border-bottom: 1px solid var(--line); }
  .bar h2 { font-size: 1.0625rem; margin: 0; line-height: 1.3; flex: 1; min-width: 0; }
  .more { font-weight: 700; padding: 10px 0; white-space: nowrap; }
  .controls .more.narrow { display: none; }
  @media (max-width: 559px) { .bar .more { display: none; } .controls .more.narrow { display: inline-block; } }
  .close {
    font: inherit; font-weight: 700; min-height: 44px; padding: 0 14px; border: 1px solid var(--ink); border-radius: 6px;
    background: transparent; color: var(--ink); cursor: pointer; flex: none; display: inline-flex; align-items: center; gap: 8px;
  }

  .stages {
    container-type: size; min-height: 0; padding: 12px var(--gutter);
    display: grid; grid-auto-flow: column; justify-content: center; align-content: center; gap: 8px;
  }
  .stage { margin: 0; position: relative; overflow: hidden; background: var(--paper-2); touch-action: none; user-select: none; -webkit-user-select: none; }
  .stages[data-both='false'] .stage { width: min(100cqw, 100cqh); aspect-ratio: 1; }
  .stages[data-both='false'] .stage:not(.on) { display: none; }
  .stages[data-both='true'] .stage { width: min(calc((100cqw - 8px) / 2), 100cqh); aspect-ratio: 1; }
  .stages.zoomed .stage { cursor: grab; }
  .stages.zoomed .stage:active { cursor: grabbing; }
  .zoom { position: absolute; inset: 0; transform-origin: 0 0; will-change: transform; }
  .zoom img { width: 100%; height: 100%; object-fit: cover; -webkit-user-drag: none; }
  .ghost {
    position: absolute; left: -11px; top: -11px; width: 22px; height: 22px; border-radius: 50%; pointer-events: none;
    border: 2px solid #fff; box-shadow: 0 0 0 1.5px #000, inset 0 0 0 1.5px #000;
  }
  .ghost[hidden] { display: none; }
  .stamp { position: absolute; left: 10px; bottom: 10px; background: #000; color: #fff; padding: 4px 10px; font-size: 0.9375rem; }

  .controls {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px;
    padding: 10px var(--gutter) 14px; border-top: 1px solid var(--line);
  }
  .switch { display: inline-flex; border: 1px solid var(--ink); border-radius: 6px; overflow: hidden; }
  .switch[hidden] { display: none; }
  .switch button, .zbtns button {
    font: inherit; font-weight: 700; min-height: 44px; padding: 0 14px; border: 0; background: transparent;
    color: var(--ink); cursor: pointer;
  }
  .switch button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  .zbtns { display: inline-flex; border: 1px solid var(--ink); border-radius: 6px; overflow: hidden; }
  .zbtns button { min-width: 44px; font-size: 1.25rem; padding: 0 12px; }
  .zbtns button + button { border-left: 1px solid var(--ink); }
  .zbtns .fit { font-size: 1rem; }
  .zbtns button:disabled { color: var(--muted); cursor: default; }
  .hint { margin: 0; flex: 1 1 260px; }
</style>
