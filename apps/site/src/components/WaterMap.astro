---
// The Pra catchment, its rivers and the clearing in it, drawn at build time as plain SVG (no map library).
import fs from 'node:fs';
import path from 'node:path';
import base from '../data/water-map.json';
import { active } from '../lib/data';
import { num } from '../lib/format';

interface Props { praHa: number }
const { praHa } = Astro.props;

type Ring = number[][];
const [W0, S0, E0, N0] = base.frame;
const K = Math.cos((((S0 + N0) / 2) * Math.PI) / 180);
const WIDTH = 640;
const scale = WIDTH / ((E0 - W0) * K);
const HEIGHT = Math.round((N0 - S0) * scale);
const x = (lon: number) => +((lon - W0) * K * scale).toFixed(1);
const y = (lat: number) => +((N0 - lat) * scale).toFixed(1);
const ring = (r: Ring) => `M${r.map(([lon, lat]) => `${x(lon)} ${y(lat)}`).join('L')}Z`;
const line = (r: Ring) => `M${r.map(([lon, lat]) => `${x(lon)} ${y(lat)}`).join('L')}`;
const area = (polys: Ring[][]) => polys.map((p) => p.map(ring).join('')).join('');

function inside([lon, lat]: number[], polys: Ring[][]) {
  let hit = false;
  for (const poly of polys) for (const r of poly) {
    for (let i = 0, j = r.length - 1; i < r.length; j = i++) {
      const [xi, yi] = r[i], [xj, yj] = r[j];
      if ((yi > lat) !== (yj > lat) && lon < ((xj - xi) * (lat - yi)) / (yj - yi) + xi) hit = !hit;
    }
  }
  return hit;
}

// About 4.4 km cells. A square's area follows the hectares cleared in it, so a full square is CELL_MAX_HA or more.
const CELL = 0.04;
const CELL_MAX_HA = 150;
const cells = new Map<string, { lon: number; lat: number; ha: number }>();
for (const p of active) {
  const i = Math.floor(p.lon / CELL), j = Math.floor(p.lat / CELL);
  const c = cells.get(`${i},${j}`) ?? { lon: (i + 0.5) * CELL, lat: (j + 0.5) * CELL, ha: 0 };
  c.ha += p.ha;
  cells.set(`${i},${j}`, c);
}
const side = CELL * K * scale;
const squares = [...cells.values()]
  .filter((c) => c.lon > W0 && c.lon < E0 && c.lat > S0 && c.lat < N0)
  .map((c) => {
    const s = +(side * Math.sqrt(Math.min(c.ha, CELL_MAX_HA) / CELL_MAX_HA) * 0.92).toFixed(1);
    return { x: +(x(c.lon) - s / 2).toFixed(1), y: +(y(c.lat) - s / 2).toFixed(1), s: Math.max(s, 1.6), pra: inside([c.lon, c.lat], base.pra as Ring[][]) };
  });

// Two paths rather than a rect per cell: about 1,200 cells would add 100 KB to the page
const squaresPath = (pra: boolean) => squares.filter((q) => q.pra === pra).map((q) => `M${q.x} ${q.y}h${q.s}v${q.s}h-${q.s}z`).join('');
const rivers = base.rivers.map((r) => ({
  d: (r.lines as Ring[]).map(line).join(''),
  w: r.km2 >= 8000 ? 3 : r.km2 >= 2000 ? 2 : 1.2,
  pra: r.pra,
}));
const cities = [
  { lon: -1.62, lat: 6.69 },
  { lon: -1.75, lat: 4.92 },
];
const plant = { x: x(base.plant.lon), y: y(base.plant.lat) };

// The other plants' catchments, outlined so readers can see why Daboase stands out (pipeline/water_plants.geojson)
type Plant = { properties: { plant: string; plant_lat: number; plant_lon: number }; geometry: { type: string; coordinates: any } };
const plantsFile = JSON.parse(fs.readFileSync(path.resolve(process.cwd(), '../../pipeline/water_plants.geojson'), 'utf8')) as { features: Plant[] };
const others = plantsFile.features.filter((f) => f.properties.plant !== 'Daboase').map((f) => ({
  name: f.properties.plant,
  d: area((f.geometry.type === 'Polygon' ? [f.geometry.coordinates] : f.geometry.coordinates) as Ring[][]),
  x: x(f.properties.plant_lon), y: y(f.properties.plant_lat),
}));
// Hand-placed so nothing overlaps at phone width: Barekese and Owabi are 8 km apart and share one label,
// and Weija's label names Accra because the two sit too close for separate labels
const labels = [
  { text: 'Kumasi', lon: -1.62, lat: 6.69, pos: 'right' },
  { text: 'Sekondi-Takoradi', lon: -1.75, lat: 4.92, pos: 'left' },
  { text: 'Barekese and Owabi', lon: -1.72, lat: 6.83, pos: 'right up' },
  { text: 'Weija plant, Accra', lon: -0.337, lat: 5.581, pos: 'left up' },
  { text: 'Kwanyako plant', lon: -0.619, lat: 5.3675, pos: 'left' },
];
---
<figure class="watermap">
  <div class="frame">
  <svg viewBox={`0 0 ${WIDTH} ${HEIGHT}`} role="img" aria-labelledby="wm-title">
    <title id="wm-title">Map of southern Ghana. The Pra and its tributaries drain a large area from north of Kumasi down to the Daboase treatment plant near the coast. {num(praHa)} hectares of the cleared land lie in that area. The smaller areas that drain to the Barekese, Owabi, Weija and Kwanyako plants are outlined and hold little cleared land.</title>
    <path class="land" d={area(base.land as Ring[][])} />
    {others.map((o) => <path class="other" d={o.d} />)}
    <path class="pra" d={area(base.pra as Ring[][])} />
    <g class="rivers" fill="none" stroke-linecap="round" stroke-linejoin="round">
      {rivers.map((r) => <path d={r.d} stroke-width={r.w} class:list={{ main: r.pra }} />)}
    </g>
    <path class="clearing" d={squaresPath(false)} />
    <path class="clearing in" d={squaresPath(true)} />
    {cities.map((c) => <circle class="city" cx={x(c.lon)} cy={y(c.lat)} r="3.5" />)}
    {others.map((o) => <rect class="plant small" x={o.x - 5} y={o.y - 5} width="10" height="10" />)}
    <rect class="plant" x={plant.x - 7} y={plant.y - 7} width="14" height="14" />
  </svg>
  <div class="labels" aria-hidden="true">
    {labels.map((l) => (
      <span class:list={['label', l.pos]} style={`left:${(x(l.lon) / WIDTH) * 100}%;top:${(y(l.lat) / HEIGHT) * 100}%`}>{l.text}</span>
    ))}
    <span class="label right strong" style={`left:${(plant.x / WIDTH) * 100}%;top:${(plant.y / HEIGHT) * 100}%`}>Daboase water plant</span>
  </div>
  </div>
  <figcaption>
    <ul class="key">
      <li><span class="sw pra-sw"></span>Land that drains to the Daboase plant</li>
      <li><span class="sw in-sw"></span>Cleared land there (bigger square, more land)</li>
      <li><span class="sw other-sw"></span>Land that drains to one of the other water plants</li>
      <li><span class="sw out-sw"></span>Cleared land that drains to other rivers, not the Pra</li>
    </ul>
    <p class="why">Daboase stands out because most of the cleared land we cover is in the Pra basin. The land that drains to the other plants holds little of it.</p>
    <p class="credit">{base.credit} Only the {num(active.length)} patches in the six areas we cover are shown.</p>
  </figcaption>
</figure>

<style>
  .watermap { margin: 0; }
  svg { display: block; width: 100%; height: auto; background: var(--sea); border: 1px solid var(--line); }
  .land { fill: var(--paper); stroke: var(--muted); stroke-width: 0.8; }
  .pra { fill: var(--river-wash); stroke: var(--river); stroke-width: 1.2; }
  .other { fill: none; stroke: var(--river); stroke-width: 1.4; stroke-dasharray: 5 3; }
  .rivers path { stroke: var(--river); opacity: 0.55; }
  .rivers path.main { opacity: 1; }
  .clearing { fill: var(--muted); }
  .clearing.in { fill: var(--signal); }
  .frame { position: relative; }
  .city { fill: var(--paper); stroke: var(--ink); stroke-width: 1.5; }
  .plant { fill: var(--ink); stroke: var(--paper); stroke-width: 2; }
  .plant.small { stroke-width: 1.5; }
  .labels { position: absolute; inset: 0; pointer-events: none; }
  /* Labels are HTML so they stay readable at phone width, where the map is drawn at half size */
  .label { position: absolute; --dx: 10px; --dy: -50%; transform: translate(var(--dx), var(--dy)); font-size: 0.875rem; font-weight: 700;
           line-height: 1.2; white-space: nowrap; background: var(--paper); padding: 1px 5px; border-radius: 3px; }
  .label.left { --dx: calc(-100% - 10px); }
  .label.up { --dy: calc(-100% - 6px); }
  .label.down { --dy: 6px; }
  .label.strong { background: var(--ink); color: var(--paper); --dx: 14px; }
  figcaption { margin-top: 12px; }
  .key { list-style: none; padding: 0; margin: 0 0 8px; display: grid; gap: 6px; font-size: 0.9375rem; }
  .key li { display: flex; align-items: center; gap: 10px; }
  .sw { width: 16px; height: 16px; flex: none; }
  .pra-sw { background: var(--river-wash); border: 1.5px solid var(--river); }
  .in-sw { background: var(--signal); }
  .out-sw { background: var(--muted); }
  .other-sw { border: 1.5px dashed var(--river); }
  .why { margin: 0 0 8px; font-size: 0.9375rem; max-width: 60ch; }
  .credit { margin: 0; font-size: 0.8125rem; color: var(--muted); }
</style>
