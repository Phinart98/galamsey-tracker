# Local development env vars for the Sentinel-1 SAR pipeline.
# Copy to .env, fill in, and `set -a; source .env; set +a` before running.

# Supabase Postgres (session/direct port 5432, NOT pooled 6543 -- pipelines need
# prepared statements and LISTEN/NOTIFY). See CLAUDE.md for the pooler hostname
# rule: aws-1-<region>.pooler.supabase.com:5432 with user postgres.<project-ref>.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Cloudflare R2 (S3-compatible). Generate from the R2 dashboard:
# https://dash.cloudflare.com -> R2 -> Manage R2 API Tokens -> Create token
# (scope: Object Read & Write, bucket: galamsey-static).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=galamsey-static
R2_PUBLIC_BASE_URL=https://<custom-or-pub-dev>.r2.dev
# Derived endpoint (account-id.r2.cloudflarestorage.com). Left blank means
# pipelines/sentinel1_sar/cog.py will assemble it from R2_ACCOUNT_ID.
R2_ENDPOINT_URL=

# Optional. MPC is anonymous for sentinel-1-rtc -- key only needed for rate-limited
# collections we don't use. Leave blank.
PC_SDK_SUBSCRIPTION_KEY=
